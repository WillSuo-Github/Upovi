    "在左侧列表中选择应用，查看版本、来源与更新操作。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تطبيقًا من القائمة لعرض إصداراته ومصادره وإجراءات تحديثه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una app de la llista per veure’n les versions, les fonts i les accions d’actualització."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte aplikaci v seznamu a zobrazte její verze, zdroje a akce aktualizace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en app på listen for at se versioner, kilder og opdateringshandlinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle links eine App aus, um Versionen, Quellen und Updateaktionen zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μια εφαρμογή στη λίστα για να δείτε εκδόσεις, πηγές και ενέργειες ενημέρωσης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an app in the list to see its versions, sources and update actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una app en la lista para ver sus versiones, fuentes y acciones de actualización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse appi luettelosta nähdäksesi versiot, lähteet ja päivitystoiminnot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une app dans la liste pour voir ses versions, sources et actions de mise à jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר יישום ברשימה כדי לראות את הגרסאות, המקורות ופעולות העדכון שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण, स्रोत और अपडेट क्रियाएँ देखने के लिए सूची में कोई ऐप चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite aplikaciju na popisu da biste vidjeli verzije, izvore i radnje ažuriranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon ki egy alkalmazást a listában a verziók, források és frissítési műveletek megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih app di daftar untuk melihat versi, sumber, dan tindakan pembaruannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un’app nell’elenco per vederne versioni, fonti e azioni di aggiornamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左のリストで App を選ぶと、バージョン、ソース、アップデート操作が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왼쪽 목록에서 앱을 선택하면 버전, 소스 및 업데이트 작업을 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apl dalam senarai untuk melihat versi, sumber dan tindakan kemas kininya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en app i listen for å se versjoner, kilder og oppdateringshandlinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een app in de lijst om versies, bronnen en updateacties te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz aplikację na liście, aby zobaczyć wersje, źródła i działania uaktualniania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
