          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P вимкнено. Кешовані публічні записи завершаться за розкладом"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P đang tắt. Các bản ghi công khai đã lưu đệm sẽ hết hạn theo lịch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
