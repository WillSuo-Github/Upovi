    "所有已扫描应用都会参与版本发现与公开共享，无需逐个选择。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشارك كل التطبيقات المفحوصة في اكتشاف الإصدارات والمشاركة العامة؛ ولا حاجة لاختيارها واحدًا تلو الآخر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Totes les apps escanejades participen en el descobriment de versions i la compartició pública; no cal triar-les una per una."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny prohledané aplikace se účastní vyhledávání verzí a veřejného sdílení; není třeba je vybírat jednotlivě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle scannede apps deltager i versionssøgning og offentlig deling; du behøver ikke vælge dem enkeltvis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gescannten Apps nehmen an Versionssuche und öffentlicher Freigabe teil; eine Einzelauswahl ist nicht nötig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι σαρωμένες εφαρμογές συμμετέχουν στην εύρεση εκδόσεων και στη δημόσια κοινή χρήση· δεν χρειάζεται να τις επιλέξετε μία-μία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All scanned apps take part in version discovery and public sharing; there’s no need to pick them individually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las apps analizadas participan en el descubrimiento de versiones y en el uso compartido público; no hace falta elegirlas una a una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki skannatut appit osallistuvat versiohakuun ja julkiseen jakamiseen; niitä ei tarvitse valita yksitellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les apps analysées participent à la découverte de versions et au partage public ; inutile de les choisir une par une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל היישומים שנסרקו משתתפים בגילוי גרסאות ובשיתוף ציבורי; אין צורך לבחור אותם אחד-אחד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी स्कैन किए गए ऐप संस्करण खोज और सार्वजनिक साझाकरण में भाग लेते हैं; उन्हें अलग-अलग चुनने की आवश्यकता नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve skenirane aplikacije sudjeluju u otkrivanju verzija i javnom dijeljenju; ne morate ih birati pojedinačno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden beolvasott alkalmazás részt vesz a verziókeresésben és a nyilvános megosztásban; nem kell egyenként kiválasztani őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua app yang dipindai ikut dalam penemuan versi dan berbagi publik; tidak perlu memilihnya satu per satu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le app analizzate partecipano al rilevamento delle versioni e alla condivisione pubblica; non serve selezionarle una per una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンしたすべての App がバージョン検出と公開共有に参加します。個別に選ぶ必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 모든 앱이 버전 탐색 및 공개 공유에 참여하므로 개별적으로 선택할 필요가 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua apl yang diimbas mengambil bahagian dalam penemuan versi dan perkongsian awam; tidak perlu memilihnya satu per satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle skannede apper deltar i versjonssøk og offentlig deling; du trenger ikke velge dem én etter én."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gescande apps doen mee aan versiedetectie en openbaar delen; je hoeft ze niet afzonderlijk te kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie przeskanowane aplikacje biorą udział w wyszukiwaniu wersji i publicznym udostępnianiu; nie trzeba wybierać ich pojedynczo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os apps analisados participam da descoberta de versões e do compartilhamento público; não é preciso escolhê-los um a um."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as apps analisadas participam na descoberta de versões e na partilha pública; não é necessário escolhê-las uma a uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate aplicațiile scanate participă la descoperirea versiunilor și la partajarea publică; nu e nevoie să le alegeți pe rând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все просканированные приложения участвуют в поиске версий и публичном обмене; выбирать их по одному не нужно."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky prehľadané aplikácie sa zúčastňujú vyhľadávania verzií a verejného zdieľania; nie je potrebné vyberať ich jednotlivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla skannade appar deltar i versionsupptäckt och offentlig delning; du behöver inte välja dem en och en."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่สแกนทั้งหมดจะเข้าร่วมการค้นหาเวอร์ชันและการแชร์สาธารณะ ไม่ต้องเลือกทีละแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taranan tüm uygulamalar sürüm keşfine ve genel paylaşıma katılır; tek tek seçmeniz gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі проскановані програми беруть участь у пошуку версій і публічному обміні; вибирати їх окремо не потрібно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ứng dụng đã quét đều tham gia khám phá phiên bản và chia sẻ công khai; không cần chọn từng ứng dụng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有已掃描 App 都會參與版本探索與公開分享，無需逐一選擇。"
          }
        }
      }
    },
