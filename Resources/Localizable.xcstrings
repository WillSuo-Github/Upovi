    "安全连接未通过，请检查网络或使用官方更新。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الاتصال الآمن. تحقّق من الشبكة أو استخدم أداة التحديث الرسمية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexió segura ha fallat. Comprova la xarxa o utilitza l’actualitzador oficial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabezpečené připojení selhalo. Zkontrolujte síť nebo použijte oficiální aktualizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sikre forbindelse mislykkedes. Kontroller netværket, eller brug den officielle opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sichere Verbindung ist fehlgeschlagen. Prüfe dein Netzwerk oder verwende die offizielle Aktualisierung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ασφαλής σύνδεση απέτυχε. Ελέγξτε το δίκτυο ή χρησιμοποιήστε την επίσημη ενημέρωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secure connection failed. Check your network or use the official updater."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la conexión segura. Revisa tu red o usa la actualización oficial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattu yhteys epäonnistui. Tarkista verkko tai käytä virallista päivitystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion sécurisée a échoué. Vérifiez votre réseau ou utilisez la mise à jour officielle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור המאובטח נכשל. בדוק את הרשת או השתמש במעדכן הרשמי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित कनेक्शन विफल रहा। अपना नेटवर्क जाँचें या आधिकारिक अपडेटर का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigurna veza nije uspjela. Provjerite mrežu ili upotrijebite službeno ažuriranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A biztonságos kapcsolat sikertelen. Ellenőrizze a hálózatot, vagy használja a hivatalos frissítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi aman gagal. Periksa jaringan Anda atau gunakan pembaru resmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione sicura non è riuscita. Controlla la rete o usa l’aggiornamento ufficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な接続を確立できませんでした。ネットワークを確認するか、公式のアップデートを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 연결에 실패했습니다. 네트워크를 확인하거나 공식 업데이트를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan selamat gagal. Semak rangkaian anda atau gunakan pengemas kini rasmi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sikre tilkoblingen mislyktes. Kontroller nettverket, eller bruk den offisielle oppdateringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beveiligde verbinding is mislukt. Controleer je netwerk of gebruik de officiële update."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się nawiązać bezpiecznego połączenia. Sprawdź sieć lub użyj oficjalnego uaktualnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão segura falhou. Verifique a rede ou use a atualização oficial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação segura falhou. Verifique a rede ou utilize a atualização oficial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea securizată a eșuat. Verificați rețeaua sau folosiți actualizarea oficială."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось установить защищённое соединение. Проверьте сеть или используйте официальное обновление."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabezpečené pripojenie zlyhalo. Skontrolujte sieť alebo použite oficiálnu aktualizáciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den säkra anslutningen misslyckades. Kontrollera nätverket eller använd den officiella uppdateringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อที่ปลอดภัยล้มเหลว โปรดตรวจสอบเครือข่ายหรือใช้ตัวอัปเดตทางการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli bağlantı başarısız oldu. Ağınızı denetleyin veya resmi güncelleyiciyi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося встановити захищене з’єднання. Перевірте мережу або використовуйте офіційне оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối bảo mật thất bại. Hãy kiểm tra mạng hoặc dùng trình cập nhật chính thức."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全連線未通過，請檢查網路或使用官方更新。"
          }
        }
      }
    },
