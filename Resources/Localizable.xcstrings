    "可以手动指定开发者的 appcast 或官方 GitHub 仓库。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تحديد appcast المطوّر أو مستودع GitHub الرسمي يدويًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots especificar manualment l’appcast del desenvolupador o el repositori oficial de GitHub."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Appcast vývojáře nebo oficiální repozitář GitHub můžete zadat ručně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan angive udviklerens appcast eller det officielle GitHub-arkiv manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Appcast des Entwicklers oder das offizielle GitHub-Repository manuell angeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να ορίσετε χειροκίνητα το appcast του προγραμματιστή ή το επίσημο αποθετήριο GitHub."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can specify the developer’s appcast or official GitHub repository manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes indicar manualmente el appcast del desarrollador o su repositorio oficial de GitHub."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit määrittää kehittäjän appcastin tai virallisen GitHub-tietovaraston käsin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez indiquer manuellement l’appcast du développeur ou son dépôt GitHub officiel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לציין ידנית את ה-appcast של המפתח או את מאגר ה-GitHub הרשמי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप डेवलपर का appcast या आधिकारिक GitHub रिपॉज़िटरी मैन्युअल रूप से निर्दिष्ट कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appcast razvojnog programera ili službeni GitHub repozitorij možete navesti ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuálisan megadhatja a fejlesztő appcastját vagy hivatalos GitHub-tárolóját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat menentukan appcast pengembang atau repositori GitHub resmi secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi indicare manualmente l’appcast dello sviluppatore o il repository GitHub ufficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者の appcast または公式 GitHub リポジトリを手動で指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자의 appcast 또는 공식 GitHub 저장소를 수동으로 지정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menentukan appcast pembangun atau repositori GitHub rasmi secara manual."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan angi utviklerens appcast eller det offisielle GitHub-arkivet manuelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de appcast van de ontwikkelaar of de officiële GitHub-repository handmatig opgeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz ręcznie podać appcast dewelopera lub oficjalne repozytorium GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode indicar manualmente o appcast do desenvolvedor ou o repositório oficial no GitHub."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode indicar manualmente o appcast do programador ou o repositório GitHub oficial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți specifica manual appcast-ul dezvoltatorului sau depozitul GitHub oficial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно вручную указать appcast разработчика или официальный репозиторий GitHub."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Appcast vývojára alebo oficiálny repozitár GitHub môžete zadať manuálne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ange utvecklarens appcast eller det officiella GitHub-förrådet manuellt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถระบุ appcast ของผู้พัฒนาหรือคลัง GitHub ทางการได้ด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
