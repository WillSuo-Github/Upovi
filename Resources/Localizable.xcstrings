    "中断、失败或当前应用身份／版本不匹配的事务会被拒绝清理。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتم تنظيف المعاملات المنقطعة أو الفاشلة أو التي لم تعد هوية التطبيق أو إصداره فيها متطابقة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es netejaran les transaccions interrompudes, fallides o en què la identitat o la versió de l’app ja no coincideix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přerušené nebo neúspěšné transakce a transakce, u nichž už nesouhlasí identifikátor nebo verze aplikace, nebudou vyčištěny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbrudte eller mislykkede transaktioner, eller transaktioner hvor appens id eller version ikke længere passer, ryddes ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterbrochene, fehlgeschlagene oder nicht mehr zur App-Kennung/-Version passende Transaktionen werden nicht bereinigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διακομμένες ή αποτυχημένες συναλλαγές, ή όσες δεν ταιριάζουν πλέον στο αναγνωριστικό ή την έκδοση της εφαρμογής, δεν θα εκκαθαριστούν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactions that were interrupted, failed, or whose app identity or version no longer matches will not be cleaned up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se limpiarán las transacciones interrumpidas, fallidas o cuya identidad o versión de app ya no coincida."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytyneitä tai epäonnistuneita tapahtumia tai tapahtumia, joiden apin tunniste tai versio ei enää täsmää, ei siivota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transactions interrompues, échouées ou dont l’identité ou la version de l’app ne correspond plus ne seront pas nettoyées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עסקאות שנקטעו, נכשלו או שזהות היישום או גרסתו אינן תואמות עוד לא ינוקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाधित, विफल या ऐसे लेन-देन जिनकी ऐप पहचान या संस्करण अब मेल नहीं खाते, साफ़ नहीं किए जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekinute ili neuspjele transakcije te transakcije kojima identifikator ili verzija aplikacije više ne odgovaraju neće se očistiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megszakadt vagy sikertelen tranzakciók, illetve azok, amelyeknél az alkalmazás azonosítója vagy verziója már nem egyezik, nem lesznek törölve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi yang terputus, gagal, atau yang identitas maupun versi app-nya tidak lagi cocok tidak akan dibersihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transazioni interrotte, non riuscite o la cui identità o versione dell’app non corrisponde più non verranno ripulite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断・失敗した、または現在の App の識別情報／バージョンが一致しないトランザクションは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단되었거나 실패했거나 현재 앱 식별자/버전이 일치하지 않는 트랜잭션은 정리되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi yang terganggu, gagal atau identiti atau versi aplnya tidak lagi sepadan tidak akan dibersihkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbrutte eller mislykkede transaksjoner, eller transaksjoner der appens ID eller versjon ikke lenger stemmer, ryddes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderbroken of mislukte transacties, of transacties waarvan de app-ID of versie niet meer overeenkomt, worden niet opgeschoond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwane, nieudane transakcje lub takie, w których identyfikator lub wersja aplikacji już się nie zgadza, nie zostaną wyczyszczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transações interrompidas, com falha ou cuja identidade ou versão do app não corresponda mais não serão limpas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As transações interrompidas, falhadas ou cuja identidade ou versão da app já não corresponda não serão limpas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacțiile întrerupte sau eșuate ori cele la care identificatorul sau versiunea aplicației nu mai corespund nu vor fi curățate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прерванные, неудачные транзакции или транзакции, у которых больше не совпадает идентификатор или версия приложения, очищены не будут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prerušené alebo neúspešné transakcie a transakcie, pri ktorých už nesedí identifikátor alebo verzia aplikácie, sa nevyčistia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbrutna eller misslyckade transaktioner, eller sådana där appens ID eller version inte längre stämmer, rensas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธุรกรรมที่ถูกขัดจังหวะ ล้มเหลว หรือมีตัวตนหรือเวอร์ชันของแอปไม่ตรงกันแล้วจะไม่ถูกล้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarıda kalan, başarısız olan veya uygulama kimliği ya da sürümü artık eşleşmeyen işlemler temizlenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перервані, невдалі транзакції або транзакції, у яких більше не збігається ідентифікатор чи версія програми, не буде очищено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các giao dịch bị gián đoạn, thất bại hoặc có danh tính hay phiên bản ứng dụng không còn khớp sẽ không được dọn dẹp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷、失敗或目前 App 身分／版本不相符的交易會被拒絕清理。"
          }
        }
      }
    },
    "主应用已恢复，其他系统改动未回滚": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة التطبيق الرئيسي؛ لم يتم التراجع عن تغييرات النظام الأخرى"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha restaurat l’app principal; els altres canvis del sistema no s’han desfet"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavní aplikace obnovena; ostatní změny systému nebyly vráceny"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedappen er gendannet; andre systemændringer er ikke rullet tilbage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Haupt-App wiederhergestellt; andere Systemänderungen wurden nicht rückgängig gemacht"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κύρια εφαρμογή επαναφέρθηκε· οι άλλες αλλαγές συστήματος δεν αναιρέθηκαν"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Main app restored; other system changes were not rolled back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App principal restaurada; no se revirtieron otros cambios del sistema"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääappi palautettiin; muita järjestelmämuutoksia ei peruttu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "App principale restaurée ; les autres modifications du système n’ont pas été annulées"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום הראשי שוחזר; שינויי מערכת אחרים לא בוטלו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य ऐप पुनर्स्थापित; अन्य सिस्टम बदलाव पूर्ववत नहीं किए गए"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glavna aplikacija vraćena; ostale promjene sustava nisu poništene"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fő alkalmazás visszaállítva; a többi rendszermódosítás nincs visszavonva"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App utama dipulihkan; perubahan sistem lainnya tidak dikembalikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App principale ripristinata; le altre modifiche di sistema non sono state annullate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン App を復元しました。その他のシステム変更は元に戻していません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 앱이 복원되었습니다. 기타 시스템 변경 사항은 되돌려지지 않았습니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl utama dipulihkan; perubahan sistem lain tidak dibuat asal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedappen er gjenopprettet; andre systemendringer er ikke tilbakestilt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdapp hersteld; andere systeemwijzigingen zijn niet teruggedraaid"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtworzono główną aplikację; inne zmiany w systemie nie zostały cofnięte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "App principal restaurado; outras alterações no sistema não foram revertidas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "App principal restaurada; outras alterações ao sistema não foram revertidas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația principală a fost restaurată; alte modificări de sistem nu au fost anulate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основное приложение восстановлено; прочие изменения системы не откачены"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlavná aplikácia obnovená; ostatné zmeny systému neboli vrátené"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Huvudappen återställdes; andra systemändringar återställdes inte"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนแอปหลักแล้ว การเปลี่ยนแปลงระบบอื่นๆ ไม่ถูกย้อนกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana uygulama geri yüklendi; diğer sistem değişiklikleri geri alınmadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Основну програму відновлено; інші зміни системи не скасовано"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục ứng dụng chính; các thay đổi hệ thống khác chưa được hoàn tác"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主 App 已還原，其他系統變更未回復"
          }
        }
      }
    },
