    "重新检测后没有可验证的更新，请查看来源状态或使用官方更新。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على تحديث قابل للتحقق بعد إعادة الفحص. راجع حالة المصدر أو استخدم أداة التحديث الرسمية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha trobat cap actualització verificable després de tornar a comprovar. Revisa l’estat de la font o utilitza l’actualitzador oficial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po nové kontrole nebyla nalezena žádná ověřitelná aktualizace. Podívejte se na stav zdroje nebo použijte oficiální aktualizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kontrollerbar opdatering blev fundet ved den nye kontrol. Se kildens status, eller brug den officielle opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach erneuter Prüfung wurde kein prüfbares Update gefunden. Sieh dir den Quellstatus an oder verwende die offizielle Aktualisierung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε επαληθεύσιμη ενημέρωση μετά τον νέο έλεγχο. Δείτε την κατάσταση της πηγής ή χρησιμοποιήστε την επίσημη ενημέρωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No verifiable update was found after rechecking. Review the source status or use the official updater."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna actualización verificable al volver a comprobar. Revisa el estado de la fuente o usa la actualización oficial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudelleentarkistuksessa ei löytynyt tarkistettavaa päivitystä. Katso lähteen tila tai käytä virallista päivitystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mise à jour vérifiable après revérification. Consultez l’état des sources ou utilisez la mise à jour officielle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא עדכון שניתן לאמת לאחר בדיקה חוזרת. עיין במצב המקור או השתמש במעדכן הרשמי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा जाँच के बाद कोई सत्यापन-योग्य अपडेट नहीं मिला। स्रोत स्थिति देखें या आधिकारिक अपडेटर का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon nove provjere nije pronađeno provjerljivo ažuriranje. Pregledajte status izvora ili upotrijebite službeno ažuriranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újraellenőrzés után sem található ellenőrizhető frissítés. Tekintse meg a forrás állapotát, vagy használja a hivatalos frissítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan pembaruan yang dapat diverifikasi setelah pemeriksaan ulang. Tinjau status sumber atau gunakan pembaru resmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun aggiornamento verificabile dopo il nuovo controllo. Controlla lo stato della fonte o usa l’aggiornamento ufficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再確認しても検証可能なアップデートはありませんでした。ソースの状態を確認するか、公式のアップデートを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 확인했지만 확인 가능한 업데이트가 없습니다. 소스 상태를 확인하거나 공식 업데이트를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada kemas kini yang boleh disahkan ditemui selepas semakan semula. Semak status sumber atau gunakan pengemas kini rasmi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kontrollerbar oppdatering ble funnet ved ny kontroll. Se kildens status, eller bruk den offisielle oppdateringen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na opnieuw controleren is geen controleerbare update gevonden. Bekijk de bronstatus of gebruik de officiële update."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po ponownym sprawdzeniu nie znaleziono weryfikowalnego uaktualnienia. Sprawdź stan źródła lub użyj oficjalnego uaktualnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma atualização verificável após nova verificação. Confira o estado da fonte ou use a atualização oficial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma atualização verificável após nova verificação. Consulte o estado da fonte ou utilize a atualização oficial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După o nouă verificare nu s-a găsit nicio actualizare verificabilă. Consultați starea sursei sau folosiți actualizarea oficială."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После повторной проверки проверяемых обновлений не найдено. Посмотрите состояние источника или используйте официальное обновление."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po novej kontrole sa nenašla žiadna overiteľná aktualizácia. Pozrite si stav zdroja alebo použite oficiálnu aktualizáciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen verifierbar uppdatering hittades vid den nya kontrollen. Granska källans status eller använd den officiella uppdateringen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบอัปเดตที่ตรวจสอบได้หลังตรวจสอบใหม่ โปรดดูสถานะแหล่งหรือใช้ตัวอัปเดตทางการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden denetimden sonra doğrulanabilir güncelleme bulunamadı. Kaynak durumunu inceleyin veya resmi güncelleyiciyi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після повторної перевірки не знайдено оновлень, які можна перевірити. Перегляньте стан джерела або використовуйте офіційне оновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy bản cập nhật có thể xác minh sau khi kiểm tra lại. Hãy xem trạng thái nguồn hoặc dùng trình cập nhật chính thức."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查後沒有可驗證的更新，請查看來源狀態或使用官方更新。"
          }
        }
      }
    },
