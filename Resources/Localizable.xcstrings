    "诊断报告保存失败，请重新选择保存位置。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ تقرير التشخيص. اختر موقعًا آخر."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’ha pogut desar l’informe de diagnòstic. Tria una altra ubicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostickou zprávu se nepodařilo uložit. Zvolte jiné umístění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosticeringsrapporten kunne ikke gemmes. Vælg en anden placering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Diagnosebericht konnte nicht gesichert werden. Wähle einen anderen Speicherort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση της αναφοράς διαγνωστικών. Επιλέξτε άλλη τοποθεσία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The diagnostic report couldn’t be saved. Choose another location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el informe de diagnóstico. Elige otra ubicación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostiikkaraporttia ei voitu tallentaa. Valitse toinen sijainti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer le rapport de diagnostic. Choisissez un autre emplacement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור את דוח האבחון. בחר מיקום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निदान रिपोर्ट सहेजी नहीं जा सकी। कोई अन्य स्थान चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dijagnostičko izvješće nije spremljeno. Odaberite drugu lokaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagnosztikai jelentést nem sikerült menteni. Válasszon másik helyet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan diagnostik tidak dapat disimpan. Pilih lokasi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il rapporto di diagnostica. Scegli un’altra posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断レポートを保存できませんでした。保存場所を選び直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 보고서를 저장하지 못했습니다. 저장 위치를 다시 선택하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan diagnostik tidak dapat disimpan. Pilih lokasi lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoserapporten kunne ikke arkiveres. Velg en annen plassering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het diagnostisch rapport kon niet worden bewaard. Kies een andere locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zachować raportu diagnostycznego. Wybierz inne miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o relatório de diagnóstico. Escolha outro local."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o relatório de diagnóstico. Escolha outra localização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportul de diagnosticare nu a putut fi salvat. Alegeți altă locație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить диагностический отчёт. Выберите другое место."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostickú správu sa nepodarilo uložiť. Zvoľte iné umiestnenie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostikrapporten kunde inte sparas. Välj en annan plats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกรายงานการวินิจฉัยไม่ได้ โปรดเลือกตำแหน่งอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanılama raporu kaydedilemedi. Başka bir konum seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти звіт діагностики. Виберіть інше місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được báo cáo chẩn đoán. Hãy chọn vị trí khác."
          }
        },
        "zh-Hant": {
          "stringUnit": {
