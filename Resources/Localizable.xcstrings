            "value": "Cette app n’apparaîtra pas dans Mises à jour, Tout mettre à jour ni dans les notifications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישום זה לא יופיע בעדכונים, ב„עדכן הכול” או בהודעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप अपडेट, “सभी अपडेट करें” या सूचनाओं में दिखाई नहीं देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova aplikacija neće se prikazivati u Ažuriranjima, opciji „Ažuriraj sve” ni u obavijestima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az alkalmazás nem jelenik meg a Frissítések és az Összes frissítése között, sem az értesítésekben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App ini tidak akan muncul di Pembaruan, Perbarui Semua, atau notifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non apparirà in Aggiornamenti, Aggiorna tutto né nelle notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この App は「アップデート」「すべてアップデート」、通知に表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
