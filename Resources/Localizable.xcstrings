    "下载并安装所有可验证的来源更新；需官方更新的应用将单独列出": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنزيل وتثبيت كل تحديثات المصدر القابلة للتحقق؛ التطبيقات التي تحتاج إلى أداة التحديث الرسمية مدرجة بشكل منفصل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega i instal·la totes les actualitzacions de la font verificables; les apps que requereixen l’actualitzador oficial es mostren a part"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhnout a nainstalovat všechny ověřitelné aktualizace ze zdrojů; aplikace vyžadující oficiální aktualizaci jsou uvedeny zvlášť"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent og installer alle kontrollerbare opdateringer fra kilder; apps, der kræver den officielle opdatering, vises separat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle prüfbaren Quell-Updates laden und installieren; Apps, die die offizielle Aktualisierung benötigen, werden separat aufgeführt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λήψη και εγκατάσταση όλων των επαληθεύσιμων ενημερώσεων από πηγές· οι εφαρμογές που απαιτούν την επίσημη ενημέρωση εμφανίζονται χωριστά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and install every verifiable source update; apps that need the official updater are listed separately"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar e instalar todas las actualizaciones verificables; las apps que requieren la actualización oficial se muestran aparte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa ja asenna kaikki tarkistettavat lähdepäivitykset; virallista päivitystä vaativat appit näytetään erikseen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger et installer toutes les mises à jour de source vérifiables ; les apps nécessitant la mise à jour officielle sont listées à part"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורד והתקן את כל עדכוני המקור הניתנים לאימות; יישומים הדורשים את המעדכן הרשמי מופיעים בנפרד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापित किए जा सकने वाले सभी स्रोत अपडेट डाउनलोड और इंस्टॉल करें; आधिकारिक अपडेटर की आवश्यकता वाले ऐप अलग से सूचीबद्ध हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzmi i instaliraj sva provjerljiva ažuriranja iz izvora; aplikacije koje zahtijevaju službeno ažuriranje navedene su zasebno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes ellenőrizhető forrásfrissítés letöltése és telepítése; a hivatalos frissítést igénylő alkalmazások külön szerepelnek"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh dan instal setiap pembaruan sumber yang dapat diverifikasi; app yang memerlukan pembaru resmi dicantumkan terpisah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica e installa tutti gli aggiornamenti verificabili; le app che richiedono l’aggiornamento ufficiale sono elencate a parte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証可能なソースアップデートをすべてダウンロードしてインストールします。公式アップデートが必要な App は別に表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 가능한 모든 소스 업데이트를 다운로드하고 설치합니다. 공식 업데이트가 필요한 앱은 따로 표시됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun dan pasang setiap kemas kini sumber yang boleh disahkan; apl yang memerlukan pengemas kini rasmi disenaraikan berasingan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last ned og installer alle kontrollerbare oppdateringer fra kilder; apper som krever den offisielle oppdateringen, vises separat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle controleerbare bronupdates downloaden en installeren; apps die de officiële update nodig hebben, staan apart vermeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz i zainstaluj wszystkie weryfikowalne uaktualnienia; aplikacje wymagające oficjalnego uaktualnienia są wymienione osobno"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixar e instalar todas as atualizações verificáveis; apps que exigem a atualização oficial aparecem separados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir e instalar todas as atualizações verificáveis; as apps que requerem a atualização oficial são listadas à parte"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă și instalează toate actualizările verificabile; aplicațiile care necesită actualizarea oficială sunt listate separat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить и установить все проверяемые обновления из источников; приложения, которым нужно официальное обновление, показаны отдельно"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahnuť a nainštalovať všetky overiteľné aktualizácie zo zdrojov; aplikácie vyžadujúce oficiálnu aktualizáciu sú uvedené osobitne"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta och installera alla verifierbara källuppdateringar; appar som kräver den officiella uppdateringen visas separat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดและติดตั้งอัปเดตจากแหล่งที่ตรวจสอบได้ทั้งหมด แอปที่ต้องใช้ตัวอัปเดตทางการจะแสดงแยกต่างหาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanabilen tüm kaynak güncellemelerini indir ve yükle; resmi güncelleyici gerektiren uygulamalar ayrıca listelenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажити й установити всі оновлення, які можна перевірити; програми, що потребують офіційного оновлення, показано окремо"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải về và cài đặt mọi bản cập nhật nguồn có thể xác minh; các ứng dụng cần trình cập nhật chính thức được liệt kê riêng"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並安裝所有可驗證的來源更新；需官方更新的 App 將另外列出"
          }
        }
      }
    },
    "下载或完整性校验未通过，请重新检测来源或使用官方更新。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التنزيل أو فحص السلامة. أعد فحص المصدر أو استخدم أداة التحديث الرسمية."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La descàrrega o la comprovació d’integritat ha fallat. Torna a comprovar la font o utilitza l’actualitzador oficial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování nebo kontrola integrity selhala. Znovu zkontrolujte zdroj nebo použijte oficiální aktualizaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentningen eller integritetskontrollen mislykkedes. Kontroller kilden igen, eller brug den officielle opdatering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download oder Integritätsprüfung fehlgeschlagen. Prüfe die Quelle erneut oder verwende die offizielle Aktualisierung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη ή ο έλεγχος ακεραιότητας απέτυχε. Ελέγξτε ξανά την πηγή ή χρησιμοποιήστε την επίσημη ενημέρωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download or integrity check failed. Recheck the source or use the official updater."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la descarga o la verificación de integridad. Vuelve a comprobar la fuente o usa la actualización oficial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataus tai eheystarkistus epäonnistui. Tarkista lähde uudelleen tai käytä virallista päivitystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ou la vérification d’intégrité a échoué. Revérifiez la source ou utilisez la mise à jour officielle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההורדה או בדיקת השלמות נכשלו. בדוק את המקור מחדש או השתמש במעדכן הרשמי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड या अखंडता जाँच विफल रही। स्रोत की दोबारा जाँच करें या आधिकारिक अपडेटर का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje ili provjera cjelovitosti nije uspjela. Ponovno provjerite izvor ili upotrijebite službeno ažuriranje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A letöltés vagy az integritás-ellenőrzés sikertelen. Ellenőrizze újra a forrást, vagy használja a hivatalos frissítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan atau pemeriksaan integritas gagal. Periksa ulang sumber atau gunakan pembaru resmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download o la verifica dell’integrità non è riuscito. Ricontrolla la fonte o usa l’aggiornamento ufficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードまたは整合性の検証に失敗しました。ソースを再確認するか、公式のアップデートを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 또는 무결성 검사에 실패했습니다. 소스를 다시 확인하거나 공식 업데이트를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
