    "向开发者来源核对；一致的版本会标记为“来源一致”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت المطابقة مع مصادر المطوّر؛ تُعلَّم الإصدارات المتطابقة بـ «مطابق للمصدر»"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparat amb les fonts del desenvolupador; les versions coincidents es marquen com a «Coincideix amb la font»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnáno se zdroji vývojáře; shodné verze jsou označeny „Zdroj potvrzuje“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenlignet med udviklerens kilder; matchende versioner markeres “Kilden bekræfter”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Entwicklerquellen abgeglichen; übereinstimmende Versionen werden als „Quelle bestätigt“ markiert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συγκρίθηκε με τις πηγές του προγραμματιστή· οι εκδόσεις που ταιριάζουν επισημαίνονται «Επιβεβαίωση πηγής»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked against developer sources; matching versions are marked “Source Matched”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado con las fuentes del desarrollador; las versiones coincidentes se marcan como «Fuente coincidente»"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrattu kehittäjän lähteisiin; täsmäävät versiot merkitään ”Lähde vahvistaa”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparé aux sources du développeur ; les versions concordantes sont marquées « Source confirmée »"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הושווה מול מקורות המפתח; גרסאות תואמות מסומנות „תואם למקור”"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपर स्रोतों से मिलान किया गया; मेल खाने वाले संस्करणों को “स्रोत से मेल” चिह्नित किया जाता है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uspoređeno s izvorima razvojnog programera; podudarne verzije označene su s „Izvor potvrđuje”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Összevetve a fejlesztői forrásokkal; az egyező verziók „Forrás megerősíti” jelölést kapnak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicocokkan dengan sumber pengembang; versi yang cocok ditandai “Sesuai Sumber”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confrontato con le fonti dello sviluppatore; le versioni corrispondenti sono contrassegnate come «Fonte confermata»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発者のソースと照合し、一致したバージョンは「ソース一致」と表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자 소스와 대조하며 일치하는 버전은 ‘소스 일치’로 표시됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disemak dengan sumber pembangun; versi yang sepadan ditandakan “Sepadan dengan Sumber”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenlignet med utviklerens kilder; samsvarende versjoner merkes «Kilden bekrefter»"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergeleken met bronnen van de ontwikkelaar; overeenkomende versies krijgen 'Bron bevestigt'"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównane ze źródłami dewelopera; zgodne wersje są oznaczane jako „Źródło potwierdza”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado às fontes do desenvolvedor; versões correspondentes são marcadas como “Fonte Confirmada”"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparado com as fontes do programador; as versões correspondentes são marcadas como “Fonte confirmada”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparat cu sursele dezvoltatorului; versiunile care coincid sunt marcate „Sursa confirmă”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверено с источниками разработчика; совпадающие версии помечаются «Источник подтверждает»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Porovnané so zdrojmi vývojára; zhodné verzie sú označené „Zdroj potvrdzuje“"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämfört med utvecklarens källor; matchande versioner markeras ”Källan bekräftar”"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบกับแหล่งของผู้พัฒนา เวอร์ชันที่ตรงกันจะถูกทำเครื่องหมาย “ตรงกับแหล่ง”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici kaynaklarıyla karşılaştırıldı; eşleşen sürümler “Kaynakla Eşleşiyor” olarak işaretlenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звірено з джерелами розробника; відповідні версії позначаються «Джерело підтверджує»"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối chiếu với nguồn của nhà phát triển; các phiên bản khớp được đánh dấu “Khớp nguồn”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向開發者來源核對；一致的版本會標示為「來源一致」"
          }
        }
      }
    },
