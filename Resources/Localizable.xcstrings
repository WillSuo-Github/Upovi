    "\n已拒绝 %lld 条回放、冲突或无效报告": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\nالتقارير المرفوضة لكونها مكررة أو متعارضة أو غير صالحة: %lld"
