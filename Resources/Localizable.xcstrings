        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V časti Aktualizácie zvoľte „Aktualizovať“ alebo „Aktualizovať všetko“ a úlohy sa zobrazia tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ”Uppdatera” eller ”Uppdatera alla” i Uppdateringar så visas uppgifterna här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก “อัปเดต” หรือ “อัปเดตทั้งหมด” ในอัปเดต แล้วงานจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeler bölümünde “Güncelle” veya “Tümünü Güncelle”yi seçin; görevler burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть «Оновити» або «Оновити все» в розділі «Оновлення», і завдання з’являться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn “Cập nhật” hoặc “Cập nhật tất cả” trong Bản cập nhật, tác vụ sẽ xuất hiện tại đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「可用更新」中選擇「更新」或「全部更新」，工作會顯示在這裡。"
