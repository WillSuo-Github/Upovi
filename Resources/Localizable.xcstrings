          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky aktualizácií môžete ignorovať v kontextovej ponuke alebo podrobnostiach aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ignorera uppdateringspåminnelser via en apps kontextmeny eller detaljer."
