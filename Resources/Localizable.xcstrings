    "未获更新来源确认，不计入更新数量，不发送更新通知。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكده أي مصدر تحديث؛ لا يُحتسب تحديثًا ولا يُرسل إشعار."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmada per cap font d’actualització; no es compta com a actualització i no s’envia cap notificació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepotvrzeno zdrojem aktualizací; nezapočítává se jako aktualizace a neodesílá se oznámení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke bekræftet af en opdateringskilde; tæller ikke som opdatering, og der sendes ingen meddelelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht von einer Updatequelle bestätigt; zählt nicht als Update und löst keine Mitteilung aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν επιβεβαιώθηκε από πηγή ενημερώσεων· δεν μετρά ως ενημέρωση και δεν στέλνεται ειδοποίηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not confirmed by an update source; not counted as an update and no notification is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No confirmado por una fuente de actualización; no cuenta como actualización ni se envía notificación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivityslähde ei ole vahvistanut tätä; sitä ei lasketa päivitykseksi eikä ilmoitusta lähetetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non confirmé par une source de mise à jour ; non compté comme mise à jour et aucune notification envoyée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא אושר על ידי מקור עדכון; אינו נספר כעדכון ולא נשלחת הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अपडेट स्रोत द्वारा पुष्टि नहीं; अपडेट के रूप में नहीं गिना जाता और कोई सूचना नहीं भेजी जाती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije potvrđeno izvorom ažuriranja; ne broji se kao ažuriranje i ne šalje se obavijest."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Frissítési forrás nem erősítette meg; nem számít frissítésnek, és nem küld értesítést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum dikonfirmasi oleh sumber pembaruan; tidak dihitung sebagai pembaruan dan tidak ada notifikasi yang dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non confermato da una fonte di aggiornamento; non conta come aggiornamento e non viene inviata alcuna notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートソースで確認されていないため、アップデート数に含めず、通知も送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 소스에서 확인되지 않아 업데이트 수에 포함되지 않으며 알림도 보내지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum disahkan oleh sumber kemas kini; tidak dikira sebagai kemas kini dan tiada pemberitahuan dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke bekreftet av en oppdateringskilde; telles ikke som oppdatering, og det sendes ikke noe varsel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet bevestigd door een updatebron; telt niet als update en er wordt geen melding verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niepotwierdzone przez źródło uaktualnień; nie jest liczone jako uaktualnienie i nie jest wysyłane powiadomienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não confirmado por uma fonte de atualização; não conta como atualização e nenhuma notificação é enviada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não confirmado por uma fonte de atualização; não conta como atualização e não é enviada notificação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Neconfirmat de o sursă de actualizare; nu este numărat ca actualizare și nu se trimite notificare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не подтверждено источником обновлений; не учитывается как обновление, уведомление не отправляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepotvrdené zdrojom aktualizácií; nezapočítava sa ako aktualizácia a neodosiela sa notifikácia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte bekräftad av en uppdateringskälla; räknas inte som uppdatering och ingen notis skickas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้รับการยืนยันจากแหล่งอัปเดต จึงไม่นับเป็นอัปเดตและจะไม่ส่งการแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir güncelleme kaynağı tarafından doğrulanmadı; güncelleme olarak sayılmaz ve bildirim gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не підтверджено джерелом оновлень; не враховується як оновлення, сповіщення не надсилається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa được nguồn cập nhật xác nhận; không tính là bản cập nhật và không gửi thông báo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未獲更新來源確認，不計入更新數量，不傳送更新通知。"
          }
        }
      }
    },
