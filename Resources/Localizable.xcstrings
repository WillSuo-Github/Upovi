    "先预览再保存，不会自动上传。默认隐藏软件标识，不读取系统或管理员授权日志。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاين قبل الحفظ؛ لا يُرفع أي شيء تلقائيًا. تُخفى معرّفات البرامج افتراضيًا، ولا تُقرأ سجلات تفويض النظام أو المسؤول."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualitza abans de desar; no es puja res automàticament. Els identificadors de programari s’amaguen per defecte i no es llegeixen els registres d’autorització del sistema ni de l’administrador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před uložením se zobrazí náhled; nic se automaticky neodesílá. Identifikátory softwaru jsou ve výchozím stavu skryté a protokoly autorizace systému či správce se nečtou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vises et eksempel, før du gemmer; intet uploades automatisk. Software-id'er er skjult som standard, og godkendelseslogs for system eller administrator læses ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Sichern wird eine Vorschau angezeigt; nichts wird automatisch hochgeladen. Softwarekennungen sind standardmäßig ausgeblendet, System- und Administrator-Autorisierungsprotokolle werden nicht gelesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πριν από την αποθήκευση εμφανίζεται προεπισκόπηση· τίποτα δεν αποστέλλεται αυτόματα. Τα αναγνωριστικά λογισμικού είναι κρυφά από προεπιλογή και τα αρχεία καταγραφής εξουσιοδότησης συστήματος ή διαχειριστή δεν διαβάζονται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview before saving; nothing is uploaded automatically. Software identifiers are hidden by default, and system or administrator authorization logs are not read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra una vista previa antes de guardar; nada se sube automáticamente. Los identificadores de software se ocultan por omisión y no se leen los registros de autorización del sistema ni de administrador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatselu näytetään ennen tallennusta; mitään ei ladata automaattisesti. Ohjelmistotunnisteet ovat oletuksena piilossa, eikä järjestelmän tai pääkäyttäjän valtuutuslokeja lueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu avant l’enregistrement ; rien n’est envoyé automatiquement. Les identifiants de logiciels sont masqués par défaut et les journaux d’autorisation système ou administrateur ne sont pas lus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג תצוגה מקדימה לפני השמירה; שום דבר לא מועלה אוטומטית. מזהי תוכנה מוסתרים כברירת מחדל, ויומני הרשאות של המערכת או המנהל אינם נקראים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने से पहले पूर्वावलोकन करें; कुछ भी अपने-आप अपलोड नहीं होता। सॉफ़्टवेयर पहचानकर्ता डिफ़ॉल्ट रूप से छिपे रहते हैं, और सिस्टम या व्यवस्थापक प्राधिकरण लॉग नहीं पढ़े जाते।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prije spremanja prikazuje se pretpregled; ništa se ne prenosi automatski. Identifikatori softvera prema zadanim su postavkama skriveni, a zapisnici autorizacije sustava ili administratora ne čitaju se."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentés előtt előnézet jelenik meg; semmi nem töltődik fel automatikusan. A szoftverazonosítók alapból rejtettek, a rendszer- és rendszergazdai engedélyezési naplók nem kerülnek beolvasásra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau sebelum menyimpan; tidak ada yang diunggah otomatis. Pengenal perangkat lunak disembunyikan secara default, dan log otorisasi sistem atau administrator tidak dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima prima del salvataggio; nulla viene caricato automaticamente. Gli identificatori software sono nascosti per impostazione predefinita e i log di autorizzazione di sistema o amministratore non vengono letti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前にプレビューします。自動ではアップロードしません。ソフトウェアの識別情報はデフォルトで非表示になり、システムや管理者の認証ログは読み取りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하기 전에 미리 봅니다. 자동으로 업로드되지 않습니다. 소프트웨어 식별자는 기본적으로 숨겨지며 시스템 또는 관리자 인증 로그는 읽지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratonton sebelum menyimpan; tiada apa yang dimuat naik secara automatik. Pengecam perisian disembunyikan secara lalai, dan log kebenaran sistem atau pentadbir tidak dibaca."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det vises en forhåndsvisning før arkivering; ingenting lastes opp automatisk. Programvare-ID-er er skjult som standard, og autorisasjonslogger for system eller administrator leses ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het bewaren wordt een voorvertoning getoond; er wordt niets automatisch geüpload. Software-ID's zijn standaard verborgen en autorisatielogboeken van systeem of beheerder worden niet gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed zachowaniem wyświetlany jest podgląd; nic nie jest wysyłane automatycznie. Identyfikatory oprogramowania są domyślnie ukryte, a dzienniki autoryzacji systemu i administratora nie są odczytywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize antes de salvar; nada é enviado automaticamente. Identificadores de software ficam ocultos por padrão e registros de autorização do sistema ou de administrador não são lidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualize antes de guardar; nada é enviado automaticamente. Os identificadores de software ficam ocultos por omissão e os registos de autorização do sistema ou de administrador não são lidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se afișează o previzualizare înainte de salvare; nimic nu se încarcă automat. Identificatorii de software sunt ascunși implicit, iar jurnalele de autorizare ale sistemului sau administratorului nu sunt citite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед сохранением отображается предпросмотр; ничего не отправляется автоматически. Идентификаторы ПО по умолчанию скрыты, журналы авторизации системы и администратора не читаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pred uložením sa zobrazí ukážka; nič sa automaticky neodosiela. Identifikátory softvéru sú predvolene skryté a protokoly autorizácie systému či správcu sa nečítajú."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En förhandsvisning visas innan du sparar; inget laddas upp automatiskt. Programvaru-ID döljs som standard och auktoriseringsloggar för system eller administratör läses inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูตัวอย่างก่อนบันทึก จะไม่มีการอัปโหลดอัตโนมัติ ตัวระบุซอฟต์แวร์จะถูกซ่อนตามค่าเริ่มต้น และจะไม่อ่านบันทึกการอนุญาตของระบบหรือผู้ดูแลระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmeden önce önizleyin; hiçbir şey otomatik yüklenmez. Yazılım tanımlayıcıları varsayılan olarak gizlenir ve sistem ya da yönetici yetkilendirme günlükleri okunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед збереженням показується попередній перегляд; нічого не надсилається автоматично. Ідентифікатори ПЗ типово приховано, журнали авторизації системи й адміністратора не читаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem trước trước khi lưu; không có gì được tải lên tự động. Mã định danh phần mềm được ẩn theo mặc định và không đọc nhật ký ủy quyền của hệ thống hay quản trị viên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先預覽再儲存，不會自動上傳。預設隱藏軟體識別，不讀取系統或管理者授權記錄。"
          }
        }
      }
    },
