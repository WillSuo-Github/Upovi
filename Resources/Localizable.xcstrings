          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha “Atualizar” ou “Atualizar tudo” em Atualizações e as tarefas aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți „Actualizează” sau „Actualizează tot” în Actualizări, iar sarcinile vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите «Обновить» или «Обновить всё» в разделе «Обновления», и задачи появятся здесь."
