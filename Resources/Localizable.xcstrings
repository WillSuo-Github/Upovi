          "stringUnit": {
            "state": "translated",
            "value": "مفعّل افتراضيًا عند الاستخدام الأول. يؤدي إيقافه إلى إيقاف الاكتشاف والنشر والرد على الطلبات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activat per defecte en el primer ús. Desactivar-lo atura el descobriment, la publicació i la resposta a sol·licituds."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při prvním použití ve výchozím stavu zapnuto. Vypnutím se zastaví vyhledávání, publikování i odpovědi na požadavky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået til som standard ved første brug. Slås det fra, stoppes søgning, udgivelse og svar på anmodninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der ersten Nutzung standardmäßig aktiv. Beim Deaktivieren werden Suche, Veröffentlichung und Antworten auf Anfragen gestoppt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργό από προεπιλογή στην πρώτη χρήση. Η απενεργοποίηση σταματά την εύρεση, τη δημοσίευση και τις απαντήσεις σε αιτήματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default on first use. Turning it off stops discovery, publishing and responding to requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por omisión en el primer uso. Al desactivarlo se detienen el descubrimiento, la publicación y las respuestas a solicitudes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletuksena päällä ensimmäisellä käyttökerralla. Kun se poistetaan käytöstä, haku, julkaisu ja pyyntöihin vastaaminen loppuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut à la première utilisation. Le désactiver arrête la découverte, la publication et les réponses aux requêtes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל כברירת מחדל בשימוש הראשון. כיבוי עוצר את הגילוי, הפרסום והמענה לבקשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहली बार उपयोग पर डिफ़ॉल्ट रूप से चालू। बंद करने से खोज, प्रकाशन और अनुरोधों का जवाब देना रुक जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri prvoj upotrebi uključeno prema zadanim postavkama. Isključivanjem se zaustavljaju otkrivanje, objavljivanje i odgovaranje na zahtjeve."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Első használatkor alapból be van kapcsolva. Kikapcsolva leáll a keresés, a közzététel és a kérések megválaszolása."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif secara default pada penggunaan pertama. Menonaktifkannya akan menghentikan penemuan, publikasi, dan respons terhadap permintaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo per impostazione predefinita al primo utilizzo. Disattivandolo si interrompono rilevamento, pubblicazione e risposte alle richieste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回使用時はデフォルトでオンです。オフにすると検出、公開、リクエストへの応答を停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 사용할 때 기본적으로 켜져 있습니다. 끄면 탐색, 게시 및 요청 응답이 중지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihidupkan secara lalai pada penggunaan pertama. Mematikannya menghentikan penemuan, penerbitan dan respons kepada permintaan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På som standard ved første bruk. Når det slås av, stoppes søk, publisering og svar på forespørsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard ingeschakeld bij eerste gebruik. Uitschakelen stopt detectie, publicatie en het beantwoorden van verzoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie włączone przy pierwszym użyciu. Wyłączenie zatrzymuje wyszukiwanie, publikowanie i odpowiadanie na żądania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por padrão no primeiro uso. Desativar interrompe a descoberta, a publicação e as respostas a solicitações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado por omissão na primeira utilização. Desativar interrompe a descoberta, a publicação e as respostas a pedidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activat implicit la prima utilizare. Dezactivarea oprește descoperirea, publicarea și răspunsurile la solicitări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию включено при первом использовании. Отключение останавливает поиск, публикацию и ответы на запросы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri prvom použití predvolene zapnuté. Vypnutím sa zastaví vyhľadávanie, publikovanie aj odpovede na požiadavky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiverat som standard vid första användning. När det stängs av stoppas upptäckt, publicering och svar på begäranden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดตามค่าเริ่มต้นเมื่อใช้ครั้งแรก การปิดจะหยุดการค้นหา การเผยแพร่ และการตอบกลับคำขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kullanımda varsayılan olarak açık. Kapatmak keşfi, yayınlamayı ve isteklere yanıt vermeyi durdurur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Типово ввімкнено під час першого використання. Вимкнення зупиняє пошук, публікацію й відповіді на запити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật theo mặc định khi dùng lần đầu. Tắt sẽ dừng khám phá, phát hành và phản hồi yêu cầu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次使用預設開啟。關閉後停止探索、發佈和回應請求。"
          }
        }
      }
    },
