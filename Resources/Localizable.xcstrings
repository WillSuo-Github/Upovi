    "在应用的右键菜单或详情中可以忽略更新提醒。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تجاهل تذكيرات التحديث من قائمة التطبيق السياقية أو تفاصيله."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots ignorar els recordatoris d’actualització des del menú contextual o els detalls d’una app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky aktualizací můžete ignorovat v místní nabídce nebo podrobnostech aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ignorere påmindelser om opdateringer i en apps genvejsmenu eller detaljer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update-Erinnerungen kannst du über das Kontextmenü oder die Details einer App ignorieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να αγνοήσετε τις υπενθυμίσεις ενημέρωσης από το μενού συντομεύσεων ή τις λεπτομέρειες μιας εφαρμογής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ignore update reminders from an app’s context menu or details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ignorar los recordatorios desde el menú contextual o los detalles de una app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit ohittaa päivitysmuistutukset apin pikavalikosta tai tiedoista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ignorer les rappels depuis le menu contextuel ou les détails d’une app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להתעלם מתזכורות עדכון דרך תפריט ההקשר או פרטי היישום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसी ऐप के संदर्भ मेनू या विवरण से अपडेट रिमाइंडर अनदेखा कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnike za ažuriranje možete zanemariti u kontekstnom izborniku ili pojedinostima aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frissítési emlékeztetőket az alkalmazás helyi menüjében vagy részleteinél mellőzheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat mengabaikan pengingat pembaruan dari menu konteks atau detail app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi ignorare i promemoria dal menu contestuale o dai dettagli di un’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のコンテキストメニューまたは詳細で、アップデート通知を無視できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 컨텍스트 메뉴나 세부 정보에서 업데이트 알림을 무시할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh mengabaikan peringatan kemas kini daripada menu konteks atau butiran apl."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ignorere oppdateringspåminnelser i en apps kontekstmeny eller detaljer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt updateherinneringen negeren via het contextmenu of de details van een app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia o uaktualnieniach można zignorować w menu kontekstowym lub szczegółach aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ignorar lembretes no menu de contexto ou nos detalhes de um app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ignorar os lembretes no menu de contexto ou nos detalhes de uma app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți ignora mementourile de actualizare din meniul contextual sau din detaliile unei aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
