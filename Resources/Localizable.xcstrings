    "授权或安装可能中断，请检查恢复选项": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما انقطع التفويض أو التثبيت؛ تحقّق من خيارات الاستعادة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorització o la instal·lació es podria haver interromput; comprova les opcions de recuperació"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizace nebo instalace mohla být přerušena; zkontrolujte možnosti obnovení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelse eller installation kan være afbrudt; kontroller mulighederne for gendannelse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisierung oder Installation wurde eventuell unterbrochen; prüfe die Wiederherstellungsoptionen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εξουσιοδότηση ή η εγκατάσταση ίσως διακόπηκε· ελέγξτε τις επιλογές ανάκτησης"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization or installation may have been interrupted; check the recovery options"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la autorización o la instalación se interrumpieran; revisa las opciones de recuperación"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valtuutus tai asennus on voinut keskeytyä; tarkista palautusvaihtoehdot"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation ou l’installation a peut-être été interrompue ; vérifiez les options de récupération"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שההרשאה או ההתקנה נקטעו; בדוק את אפשרויות השחזור"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राधिकरण या इंस्टॉलेशन बाधित हुआ हो सकता है; पुनर्प्राप्ति विकल्प जाँचें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizacija ili instalacija možda je prekinuta; provjerite opcije oporavka"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az engedélyezés vagy a telepítés megszakadhatott; ellenőrizze a helyreállítási lehetőségeket"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorisasi atau instalasi mungkin terputus; periksa opsi pemulihan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorizzazione o l’installazione potrebbe essere stata interrotta; controlla le opzioni di ripristino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
