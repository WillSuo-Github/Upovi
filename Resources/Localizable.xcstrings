          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi skanner /Applications og ~/Applications og sammenligner deretter versjonene med Sparkle, Homebrew, GitHub og App Store."
          }
        },
        "nl": {
          "stringUnit": {
