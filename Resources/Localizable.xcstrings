    "清理未完成，恢复已停用；可继续清理残留": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنظيف غير مكتمل والاستعادة معطّلة؛ يمكنك متابعة تنظيف البقايا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Neteja incompleta i restauració desactivada; pots continuar netejant les restes"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čištění nedokončeno, obnovení vypnuto; zbytky můžete dál odstraňovat"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprydning ikke fuldført, gendannelse slået fra; du kan fortsætte med at rydde rester"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigung unvollständig, Wiederherstellung deaktiviert; Reste können weiter entfernt werden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη ολοκληρωμένη εκκαθάριση, η επαναφορά απενεργοποιήθηκε· μπορείτε να συνεχίσετε την εκκαθάριση των υπολειμμάτων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup incomplete and restore disabled; you can continue cleaning up leftovers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpieza incompleta y restauración desactivada; puedes seguir eliminando restos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siivous kesken, palautus poistettu käytöstä; voit jatkaa jäänteiden poistamista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoyage inachevé, restauration désactivée ; vous pouvez continuer à supprimer les restes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניקוי לא הושלם והשחזור מושבת; ניתן להמשיך לנקות שאריות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफ़ाई अधूरी और पुनर्स्थापना अक्षम; आप बचे हुए हिस्से साफ़ करना जारी रख सकते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čišćenje nije dovršeno, vraćanje isključeno; ostatke možete nastaviti čistiti"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tisztítás befejezetlen, a visszaállítás letiltva; a maradványok törlése folytatható"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan belum selesai dan pemulihan dinonaktifkan; Anda dapat melanjutkan membersihkan sisa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulizia incompleta, ripristino disattivato; puoi continuare a rimuovere i residui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除が完了していません。復元は無効です。残りの削除を続行できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 미완료. 복원이 비활성화됨. 남은 항목을 계속 정리할 수 있음"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembersihan tidak lengkap dan pemulihan dinyahdayakan; anda boleh terus membersihkan sisa"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprydding ikke fullført, gjenoppretting slått av; du kan fortsette å fjerne rester"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opschonen onvoltooid, herstel uitgeschakeld; je kunt restanten verder verwijderen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie nieukończone, odtwarzanie wyłączone; można dalej usuwać pozostałości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpeza incompleta e restauração desativada; você pode continuar removendo os restos"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpeza incompleta e restauro desativado; pode continuar a remover os restos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Curățare neterminată, restaurare dezactivată; puteți continua curățarea resturilor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка не завершена, восстановление отключено; можно продолжить удаление остатков"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čistenie nedokončené, obnovenie vypnuté; zvyšky môžete ďalej odstraňovať"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensningen ej slutförd, återställning avaktiverad; du kan fortsätta rensa rester"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การล้างไม่เสร็จสมบูรณ์และปิดการกู้คืนแล้ว คุณสามารถล้างส่วนที่เหลือต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizleme tamamlanmadı ve geri yükleme devre dışı; kalıntıları temizlemeye devam edebilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищення не завершено, відновлення вимкнено; можна продовжити видалення залишків"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dọn dẹp chưa hoàn tất và đã tắt khôi phục; bạn có thể tiếp tục dọn phần còn sót"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理未完成，還原已停用；可繼續清理殘留"
          }
        }
      }
    },
    "清理状态尚未确认，请先核对管理员记录": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تأكيد حالة التنظيف؛ تحقّق من سجل المسؤول أولًا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estat de la neteja no confirmat; verifica primer el registre de l’administrador"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav čištění není potvrzen; nejdříve zkontrolujte záznam správce"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprydningsstatus ikke bekræftet; kontroller administratorposten først"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigungsstatus unbestätigt; prüfe zuerst den Administratoreintrag"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κατάσταση εκκαθάρισης δεν επιβεβαιώθηκε· ελέγξτε πρώτα την εγγραφή διαχειριστή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleanup status unconfirmed; verify the administrator record first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de la limpieza sin confirmar; revisa primero el registro de administrador"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siivouksen tilaa ei ole vahvistettu; tarkista ensin pääkäyttäjän tietue"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État du nettoyage non confirmé ; vérifiez d’abord l’enregistrement administrateur"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב הניקוי לא אושר; אמת תחילה את רשומת המנהל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफ़ाई स्थिति की पुष्टि नहीं हुई; पहले व्यवस्थापक रिकॉर्ड सत्यापित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Status čišćenja nije potvrđen; najprije provjerite administratorski zapis"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tisztítás állapota nincs megerősítve; előbb ellenőrizze a rendszergazdai rekordot"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status pembersihan belum dikonfirmasi; verifikasi catatan administrator terlebih dahulu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato della pulizia non confermato; controlla prima il record amministratore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除の状態が未確認です。先に管理者の記録を確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 상태가 확인되지 않음. 먼저 관리자 기록을 확인하십시오"
          }
        },
        "ms": {
          "stringUnit": {
