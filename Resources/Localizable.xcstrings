          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна вручну вказати appcast розробника або офіційний репозиторій GitHub."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chỉ định thủ công appcast của nhà phát triển hoặc kho GitHub chính thức."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以手動指定開發者的 appcast 或官方 GitHub 儲存庫。"
          }
        }
      }
    },
    "可以通过 Apple 商店服务检查并更新；可能需要拥有该应用的 Apple 账户认证。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن فحصه وتحديثه عبر خدمة App Store من Apple؛ وقد تلزم المصادقة بحساب Apple المالك للتطبيق."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es pot comprovar i actualitzar mitjançant el servei de l’App Store d’Apple; pot caldre autenticar-se amb el compte d’Apple propietari de l’app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lze zkontrolovat a aktualizovat přes službu App Store od Applu; může být vyžadováno přihlášení účtem Apple, kterému aplikace patří."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan kontrolleres og opdateres via Apples App Store-tjeneste; login med den Apple-konto, der ejer appen, kan være påkrævet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann über den App Store-Dienst von Apple geprüft und aktualisiert werden; eine Anmeldung mit dem Apple Account, dem die App gehört, kann nötig sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορεί να ελεγχθεί και να ενημερωθεί μέσω της υπηρεσίας App Store της Apple· ίσως απαιτείται σύνδεση με τον λογαριασμό Apple στον οποίο ανήκει η εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can be checked and updated through Apple’s App Store service; authentication with the Apple Account that owns the app may be required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede comprobarse y actualizarse mediante el servicio App Store de Apple; puede requerirse autenticación con la cuenta de Apple propietaria de la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voidaan tarkistaa ja päivittää Applen App Store -palvelun kautta; apin omistavalla Apple-tilillä kirjautuminen voi olla tarpeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut être vérifiée et mise à jour via le service App Store d’Apple ; une authentification avec le compte Apple propriétaire de l’app peut être requise."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבדוק ולעדכן דרך שירות App Store של Apple; ייתכן שיידרש אימות עם חשבון Apple שבבעלותו היישום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple की App Store सेवा के ज़रिए जाँचा और अपडेट किया जा सकता है; ऐप के स्वामी Apple खाते से प्रमाणीकरण आवश्यक हो सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Može se provjeriti i ažurirati putem Appleove usluge App Store; možda će biti potrebna prijava Apple računom koji je vlasnik aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple App Store-szolgáltatásával ellenőrizhető és frissíthető; szükség lehet az alkalmazás tulajdonosi Apple-fiókjával való hitelesítésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat diperiksa dan diperbarui melalui layanan App Store Apple; autentikasi dengan Akun Apple pemilik app mungkin diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può essere controllata e aggiornata tramite il servizio App Store di Apple; potrebbe essere necessaria l’autenticazione con l’Account Apple proprietario dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の App Store サービスで確認・アップデートできます。この App を所有する Apple アカウントでの認証が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple App Store 서비스를 통해 확인 및 업데이트할 수 있습니다. 앱을 소유한 Apple 계정의 인증이 필요할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh disemak dan dikemas kini melalui perkhidmatan App Store Apple; pengesahan dengan Akaun Apple yang memiliki apl mungkin diperlukan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan kontrolleres og oppdateres via Apples App Store-tjeneste; pålogging med Apple-kontoen som eier appen, kan være påkrevd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan worden gecontroleerd en bijgewerkt via de App Store-dienst van Apple; inloggen met de Apple Account die eigenaar is van de app kan nodig zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można sprawdzić i uaktualnić za pomocą usługi App Store firmy Apple; może być wymagane uwierzytelnienie kontem Apple, do którego należy aplikacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser verificado e atualizado pelo serviço App Store da Apple; pode ser preciso autenticar com a Conta Apple dona do app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser verificada e atualizada através do serviço App Store da Apple; poderá ser necessária autenticação com a Conta Apple proprietária da app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poate fi verificată și actualizată prin serviciul App Store de la Apple; poate fi necesară autentificarea cu contul Apple care deține aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно проверить и обновить через службу App Store от Apple; может потребоваться вход с Аккаунтом Apple, которому принадлежит приложение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Možno skontrolovať a aktualizovať cez službu App Store od Apple; môže byť potrebné prihlásenie účtom Apple, ktorému aplikácia patrí."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan kontrolleras och uppdateras via Apples App Store-tjänst; inloggning med det Apple-konto som äger appen kan krävas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบและอัปเดตผ่านบริการ App Store ของ Apple ได้ อาจต้องยืนยันตัวตนด้วยบัญชี Apple ที่เป็นเจ้าของแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple’ın App Store hizmeti üzerinden denetlenip güncellenebilir; uygulamanın sahibi olan Apple Hesabı ile kimlik doğrulama gerekebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна перевірити й оновити через службу App Store від Apple; може знадобитися вхід з обліковим записом Apple, якому належить програма."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể kiểm tra và cập nhật qua dịch vụ App Store của Apple; có thể cần xác thực bằng Tài khoản Apple sở hữu ứng dụng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以透過 Apple 商店服務檢查並更新；可能需要擁有該 App 的 Apple 帳號驗證。"
          }
        }
      }
    },
