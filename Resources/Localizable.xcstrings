        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcarea sau verificarea integrității a eșuat. Verificați din nou sursa sau folosiți actualizarea oficială."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
