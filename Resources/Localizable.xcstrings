          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisasjon eller installering kan ha blitt avbrutt; kontroller gjenopprettingsvalgene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisatie of installatie is mogelijk onderbroken; controleer de herstelopties"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoryzacja lub instalacja mogła zostać przerwana; sprawdź opcje odtwarzania"
