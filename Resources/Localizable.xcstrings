        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg “Opdater” eller “Opdater alle” i Opdateringer, så vises opgaverne her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle unter „Updates“ „Aktualisieren“ oder „Alle aktualisieren“; die Vorgänge erscheinen dann hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε «Ενημέρωση» ή «Ενημέρωση όλων» στις Ενημερώσεις και οι εργασίες θα εμφανιστούν εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose “Update” or “Update All” in Updates, and tasks will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Actualizar» o «Actualizar todo» en Actualizaciones y las tareas aparecerán aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Päivitykset-kohdasta ”Päivitä” tai ”Päivitä kaikki”, niin tehtävät näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Mettre à jour » ou « Tout mettre à jour » dans Mises à jour ; les tâches apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר „עדכן” או „עדכן הכול” בעדכונים, והמשימות יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट में “अपडेट करें” या “सभी अपडेट करें” चुनें, कार्य यहाँ दिखाई देंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U odjeljku Ažuriranja odaberite „Ažuriraj” ili „Ažuriraj sve” i zadaci će se prikazati ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Frissítések részen válassza a „Frissítés” vagy az „Összes frissítése” lehetőséget, és a feladatok itt jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih “Perbarui” atau “Perbarui Semua” di Pembaruan, dan tugas akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli «Aggiorna» o «Aggiorna tutto» in Aggiornamenti e le attività appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アップデート」で「アップデート」または「すべてアップデート」を選ぶと、ここにタスクが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘업데이트’에서 ‘업데이트’ 또는 ‘모두 업데이트’를 선택하면 작업이 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih “Kemas Kini” atau “Kemas Kini Semua” dalam Kemas Kini, dan tugas akan muncul di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg «Oppdater» eller «Oppdater alle» i Oppdateringer, så vises oppgavene her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies 'Werk bij' of 'Werk alles bij' in Updates; de taken verschijnen dan hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz „Uaktualnij” lub „Uaktualnij wszystko” w sekcji Uaktualnienia, a zadania pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
