            "value": "Reia mementourile pentru această versiune"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновить напоминания для этой версии"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnoviť pripomienky tejto verzie"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återuppta påminnelser för den här versionen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กลับมาเตือนสำหรับเวอร์ชันนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
