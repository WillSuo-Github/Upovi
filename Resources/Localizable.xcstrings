    "不包含路径、用户名、设备名或安装包。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُضمَّن المسارات وأسماء المستخدمين وأسماء الأجهزة والمثبّتات."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s’hi inclouen camins, noms d’usuari, noms de dispositiu ni instal·ladors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesty, uživatelská jména, názvy zařízení ani instalátory nejsou zahrnuty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stier, brugernavne, enhedsnavne og installationsprogrammer medtages ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfade, Benutzernamen, Gerätenamen und Installationsprogramme sind nicht enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν περιλαμβάνονται διαδρομές, ονόματα χρηστών, ονόματα συσκευών ή προγράμματα εγκατάστασης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paths, user names, device names and installers are not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se incluyen rutas, nombres de usuario, nombres de dispositivo ni instaladores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Polkuja, käyttäjänimiä, laitenimiä tai asentajia ei sisällytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chemins, noms d’utilisateur, noms d’appareil et programmes d’installation ne sont pas inclus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתיבים, שמות משתמשים, שמות מכשירים ומתקינים אינם נכללים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पथ, उपयोगकर्ता नाम, डिवाइस नाम और इंस्टॉलर शामिल नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Putanje, korisnička imena, nazivi uređaja i instalacijski programi nisu uključeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Útvonalak, felhasználónevek, eszköznevek és telepítők nem szerepelnek benne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalur, nama pengguna, nama perangkat, dan penginstal tidak disertakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorsi, nomi utente, nomi dei dispositivi e programmi di installazione non sono inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パス、ユーザ名、デバイス名、インストーラは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로, 사용자 이름, 기기 이름 또는 설치 프로그램은 포함되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laluan, nama pengguna, nama peranti dan pemasang tidak disertakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Baner, brukernavn, enhetsnavn og installeringsprogrammer tas ikke med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paden, gebruikersnamen, apparaatnamen en installatieprogramma's worden niet meegenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścieżki, nazwy użytkowników, nazwy urządzeń i instalatory nie są dołączane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhos, nomes de usuário, nomes de dispositivo e instaladores não são incluídos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não são incluídos caminhos, nomes de utilizador, nomes de dispositivo nem instaladores."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căile, numele de utilizator, numele dispozitivelor și programele de instalare nu sunt incluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пути, имена пользователей, имена устройств и установщики не включаются."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesty, mená používateľov, názvy zariadení ani inštalátory nie sú zahrnuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökvägar, användarnamn, enhetsnamn och installationsprogram ingår inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่รวมพาธ ชื่อผู้ใช้ ชื่ออุปกรณ์ หรือตัวติดตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yollar, kullanıcı adları, aygıt adları ve yükleyiciler dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шляхи, імена користувачів, назви пристроїв та інсталятори не включено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao gồm đường dẫn, tên người dùng, tên thiết bị hay trình cài đặt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不包含路徑、使用者名稱、裝置名稱或安裝檔。"
          }
        }
      }
    },
