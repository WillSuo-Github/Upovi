    "管理员保留数据已清理，事务记录已保留": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تنظيف البيانات المحتفظ بها للمسؤول؛ تم الاحتفاظ بسجل المعاملة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’han netejat les dades conservades de l’administrador; s’ha conservat el registre de la transacció"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovaná data správce odstraněna; záznam transakce zachován"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorens gemte data er ryddet; transaktionsposten er bevaret"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufbewahrte Administratordaten entfernt; Transaktionseintrag aufbewahrt"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα διαχειριστή που διατηρούνταν εκκαθαρίστηκαν· η εγγραφή συναλλαγής διατηρήθηκε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator retained data cleaned up; transaction record kept"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos conservados del administrador eliminados; se conservó el registro de transacción"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääkäyttäjän säilytetyt tiedot poistettiin; tapahtumatietue säilytettiin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données administrateur conservées supprimées ; enregistrement de transaction conservé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים שנשמרו על ידי המנהל נוקו; רשומת העסקה נשמרה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवस्थापक का रखा गया डेटा साफ़ किया गया; लेन-देन रिकॉर्ड रखा गया"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sačuvani podaci administratora očišćeni; zapis transakcije sačuvan"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszergazdai megőrzött adatok törölve; a tranzakciós rekord megmaradt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tersimpan administrator dibersihkan; catatan transaksi disimpan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati conservati dell’amministratore rimossi; record della transazione conservato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者の保持データを削除しました。トランザクション記録は保持しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 보관 데이터가 정리됨. 트랜잭션 기록은 보관됨"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tersimpan pentadbir dibersihkan; rekod transaksi disimpan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratorens lagrede data er fjernet; transaksjonsoppføringen er beholdt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde beheerdersgegevens verwijderd; transactierecord bewaard"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto zachowane dane administratora; zachowano zapis transakcji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados mantidos do administrador removidos; registro da transação mantido"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados mantidos do administrador removidos; registo da transação mantido"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele păstrate ale administratorului au fost curățate; înregistrarea tranzacției a fost păstrată"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые данные администратора удалены; запись транзакции сохранена"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchované údaje správcu odstránené; záznam transakcie zachovaný"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratörens sparade data rensades; transaktionsposten behölls"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล้างข้อมูลที่ผู้ดูแลระบบเก็บไว้แล้ว เก็บบันทึกธุรกรรมไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yöneticinin sakladığı veriler temizlendi; işlem kaydı saklandı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені дані адміністратора видалено; запис транзакції збережено"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dọn dẹp dữ liệu quản trị viên đã giữ; đã giữ bản ghi giao dịch"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者保留資料已清理，交易記錄已保留"
          }
        }
      }
    },
    "管理员备份操作未完成；原有事务记录已保留，请核对状态：%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل عملية النسخة الاحتياطية للمسؤول؛ تم الاحتفاظ بسجل المعاملة الحالي. تحقّق من حالته: %@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operació amb la còpia de l’administrador no ha acabat; s’ha conservat el registre de transacció existent. Comprova’n l’estat: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Operace se zálohou správce nebyla dokončena; stávající záznam transakce zůstal zachován. Zkontrolujte stav: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen på administratorsikkerhedskopien blev ikke fuldført; den eksisterende transaktionspost er bevaret. Kontroller status: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Administrator-Backup-Vorgang wurde nicht abgeschlossen; der bestehende Transaktionseintrag wurde aufbewahrt. Prüfe den Status: %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ενέργεια στο εφεδρικό αντίγραφο διαχειριστή δεν ολοκληρώθηκε· η υπάρχουσα εγγραφή συναλλαγής διατηρήθηκε. Ελέγξτε την κατάσταση: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The administrator backup operation didn’t finish; the existing transaction record was kept. Check its status: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación sobre la copia de administrador no terminó; se conservó el registro de transacción existente. Revisa su estado: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pääkäyttäjän varmuuskopion toiminto ei valmistunut; olemassa oleva tapahtumatietue säilytettiin. Tarkista tila: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération sur la sauvegarde administrateur n’a pas abouti ; l’enregistrement de transaction existant est conservé. Vérifiez son état : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולת גיבוי המנהל לא הסתיימה; רשומת העסקה הקיימת נשמרה. בדוק את מצבה: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवस्थापक बैकअप कार्य पूरा नहीं हुआ; मौजूदा लेन-देन रिकॉर्ड रखा गया। इसकी स्थिति जाँचें: %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radnja nad administratorskom sigurnosnom kopijom nije dovršena; postojeći zapis transakcije sačuvan je. Provjerite status: %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rendszergazdai biztonsági másolat művelete nem fejeződött be; a meglévő tranzakciós rekord megmaradt. Ellenőrizze az állapotot: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi cadangan administrator belum selesai; catatan transaksi yang ada disimpan. Periksa statusnya: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’operazione sul backup amministratore non è stata completata; il record della transazione esistente è stato conservato. Controllane lo stato: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者のバックアップ操作が完了しませんでした。既存のトランザクション記録は保持されています。状態を確認してください：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리자 백업 작업이 완료되지 않았습니다. 기존 트랜잭션 기록은 보관되었습니다. 상태를 확인하십시오: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi sandaran pentadbir tidak selesai; rekod transaksi sedia ada disimpan. Semak statusnya: %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen på administratorsikkerhetskopien ble ikke fullført; den eksisterende transaksjonsoppføringen er beholdt. Kontroller statusen: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewerking op de beheerdersreservekopie is niet voltooid; het bestaande transactierecord is bewaard. Controleer de status: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja na kopii administratora nie została ukończona; istniejący zapis transakcji zachowano. Sprawdź stan: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação no backup de administrador não foi concluída; o registro da transação existente foi mantido. Verifique o estado: %@"
