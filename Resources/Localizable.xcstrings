          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma app na lista para ver as versões, fontes e ações de atualização."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
