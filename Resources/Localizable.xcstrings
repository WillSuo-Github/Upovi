    "网络不可用，联网后恢复检查": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشبكة غير متاحة؛ يُستأنف الفحص عند عودة الاتصال"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Xarxa no disponible; les comprovacions es reprendran quan tornis a tenir connexió"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síť není dostupná; kontroly budou obnoveny po připojení"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværket er ikke tilgængeligt; kontroller genoptages, når du er online"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk nicht verfügbar; Prüfungen werden fortgesetzt, sobald du online bist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το δίκτυο δεν είναι διαθέσιμο· οι έλεγχοι θα συνεχιστούν όταν συνδεθείτε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network unavailable; checks resume when you’re back online"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red no disponible; las comprobaciones se reanudarán cuando haya conexión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkko ei ole käytettävissä; tarkistukset jatkuvat, kun olet verkossa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseau indisponible ; les vérifications reprendront une fois en ligne"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין רשת זמינה; הבדיקות יחודשו כשתחזור להיות מחובר"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क उपलब्ध नहीं; ऑनलाइन लौटने पर जाँच फिर शुरू होगी"
