    "恢复所有跳过与稍后提醒": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعادة كل المتخطى والمؤجل"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura totes les omeses i ajornades"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátit všechny přeskočené a odložené"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan alle sprungne og udsatte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Übersprungenen und Verschobenen wiederherstellen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφορά όλων των παραλειφθέντων και αναβληθέντων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore All Skipped and Postponed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablecer todo lo omitido y pospuesto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauta kaikki sivuutetut ja lykätyt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir tout ce qui est sauté ou reporté"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שחזר את כל מה שדולג ונדחה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी छोड़े गए और स्थगित पुनर्स्थापित करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrati sve preskočene i odgođene"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Összes kihagyott és elhalasztott visszaállítása"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan Semua yang Dilewati dan Ditunda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina tutti i saltati e posticipati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップと延期をすべて解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 건너뛰기 및 나중에 알림 해제"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulihkan Semua yang Dilangkau dan Ditangguhkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprett alle som er hoppet over og utsatt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel alle overgeslagen en uitgestelde"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć wszystkie pominięte i odłożone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar Todos os Pulados e Adiados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Repor todas as saltadas e adiadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurează toate cele omise și amânate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть все пропущенные и отложенные"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrátiť všetky preskočené a odložené"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ alla överhoppade och uppskjutna"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนรายการที่ข้ามและเลื่อนไว้ทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlanan ve Ertelenenlerin Tümünü Geri Al"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернути всі пропущені й відкладені"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục tất cả mục đã bỏ qua và đã hoãn"
          }
        },
        "zh-Hant": {
          "stringUnit": {
