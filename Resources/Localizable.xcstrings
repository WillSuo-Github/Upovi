    "开发命令行版本未配置自身更新，请使用完整应用包。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد التحديث الذاتي لبنية سطر الأوامر الخاصة بالتطوير. استخدم حزمة التطبيق الكاملة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilació de línia d’ordres de desenvolupament no té configurada l’autoactualització. Utilitza el paquet complet de l’app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vývojářská verze pro příkazový řádek nemá vlastní aktualizace. Použijte úplný balík aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandolinjeversionen til udvikling har ingen selvopdatering. Brug den fulde appbundt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kommandozeilen-Entwicklerversion hat keine Selbstaktualisierung. Verwende das vollständige App-Bundle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκδοση ανάπτυξης γραμμής εντολών δεν έχει αυτόματη ενημέρωση. Χρησιμοποιήστε το πλήρες πακέτο εφαρμογής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The development command-line build has no self-update configured. Use the complete app bundle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de desarrollo de línea de comandos no tiene autoactualización. Usa el paquete de app completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehityskäyttöön tarkoitetussa komentoriviversiossa ei ole itsepäivitystä. Käytä koko appipakettia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de développement en ligne de commande n’a pas de mise à jour automatique. Utilisez le paquet d’app complet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבילד שורת הפקודה לפיתוח לא הוגדר עדכון עצמי. השתמש בחבילת היישום המלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपमेंट कमांड-लाइन बिल्ड में स्व-अपडेट कॉन्फ़िगर नहीं है। पूरे ऐप बंडल का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvojna verzija za naredbeni redak nema samoažuriranje. Upotrijebite cijeli paket aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fejlesztői parancssori verzió nem rendelkezik önfrissítéssel. Használja a teljes alkalmazáscsomagot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Build baris perintah pengembangan tidak memiliki pembaruan mandiri. Gunakan bundel app lengkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione da riga di comando per lo sviluppo non ha l’aggiornamento automatico. Usa il pacchetto completo dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発用のコマンドライン版では自己アップデートが設定されていません。完全な App バンドルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발용 명령줄 버전에는 자체 업데이트가 구성되지 않았습니다. 전체 앱 번들을 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Binaan baris perintah pembangunan tiada kemas kini kendiri. Gunakan berkas apl lengkap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandolinjeversjonen for utvikling har ingen selvoppdatering. Bruk den fullstendige appbunten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ontwikkelversie voor de opdrachtregel heeft geen zelfupdate. Gebruik de volledige appbundel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja deweloperska wiersza poleceń nie ma samouaktualniania. Użyj pełnego pakietu aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão de desenvolvimento de linha de comando não tem autoatualização. Use o pacote completo do app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão de desenvolvimento de linha de comandos não tem atualização automática. Utilize o pacote completo da app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiunea de dezvoltare pentru linia de comandă nu are autoactualizare. Folosiți pachetul complet al aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У консольной версии для разработки нет самообновления. Используйте полный пакет приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vývojárska verzia pre príkazový riadok nemá vlastné aktualizácie. Použite úplný balík aplikácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoradsversionen för utveckling saknar självuppdatering. Använd hela appaketet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บิลด์บรรทัดคำสั่งสำหรับการพัฒนาไม่ได้ตั้งค่าการอัปเดตตัวเอง โปรดใช้บันเดิลแอปฉบับสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirme komut satırı yapısında kendi kendini güncelleme yapılandırılmamış. Tam uygulama paketini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Консольна версія для розробки не має самооновлення. Використовуйте повний пакет програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng dòng lệnh dành cho phát triển chưa cấu hình tự cập nhật. Hãy dùng gói ứng dụng đầy đủ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發用命令列版本未設定自身更新，請使用完整 App 套件。"
          }
        }
      }
    },
