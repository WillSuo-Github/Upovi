    "结果为空并不代表所有应用都已是最新": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم وجود نتائج لا يعني أن كل التطبيقات محدَّثة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No tenir resultats no vol dir que totes les apps estiguin actualitzades"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdné výsledky neznamenají, že jsou všechny aplikace aktuální"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen resultater betyder ikke, at alle apps er opdaterede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Ergebnisse bedeuten nicht, dass alle Apps aktuell sind"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απουσία αποτελεσμάτων δεν σημαίνει ότι όλες οι εφαρμογές είναι ενημερωμένες"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No results doesn’t mean every app is up to date"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No obtener resultados no significa que todas las apps estén actualizadas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulosten puuttuminen ei tarkoita, että kaikki appit ovat ajan tasalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’absence de résultats ne signifie pas que toutes les apps sont à jour"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היעדר תוצאות אינו אומר שכל היישומים מעודכנים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई परिणाम न होने का अर्थ यह नहीं कि हर ऐप नवीनतम है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izostanak rezultata ne znači da su sve aplikacije ažurne"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eredmények hiánya nem jelenti, hogy minden alkalmazás naprakész"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada hasil bukan berarti setiap app sudah terbaru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun risultato non significa che tutte le app siano aggiornate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果がなくても、すべての App が最新とは限りません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 없다고 모든 앱이 최신인 것은 아닙니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada keputusan tidak bermakna setiap apl sudah terkini"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen resultater betyr ikke at alle apper er oppdatert"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen resultaten betekent niet dat alle apps bijgewerkt zijn"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wyników nie oznacza, że wszystkie aplikacje są aktualne"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum resultado não significa que todos os apps estão atualizados"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ausência de resultados não significa que todas as apps estão atualizadas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipsa rezultatelor nu înseamnă că toate aplicațiile sunt actualizate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсутствие результатов не означает, что все приложения актуальны"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdne výsledky neznamenajú, že všetky aplikácie sú aktuálne"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga resultat betyder inte att alla appar är uppdaterade"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การไม่มีผลลัพธ์ไม่ได้หมายความว่าทุกแอปเป็นเวอร์ชันล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç olmaması her uygulamanın güncel olduğu anlamına gelmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсутність результатів не означає, що всі програми актуальні"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết quả không có nghĩa là mọi ứng dụng đều đã mới nhất"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果為空並不代表所有 App 都已是最新"
          }
        }
      }
    },
