    "来源更新提醒已启用。社区版本仍只作为线索。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرات تحديثات المصدر مفعّلة. ولا تزال إصدارات المجتمع تُعامل كتلميحات فقط."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els recordatoris d’actualitzacions de la font estan activats. Les versions de la comunitat continuen sent només pistes."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky aktualizací ze zdrojů jsou zapnuté. Verze od komunity jsou nadále jen tipy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelser om opdateringer fra kilder er slået til. Fællesskabsversioner betragtes stadig kun som tip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen für Quell-Updates sind aktiviert. Community-Versionen gelten weiterhin nur als Hinweise."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υπενθυμίσεις ενημερώσεων από πηγές είναι ενεργές. Οι εκδόσεις της κοινότητας παραμένουν μόνο ενδείξεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source update reminders are on. Community versions are still treated only as leads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios de actualizaciones de la fuente están activados. Las versiones de la comunidad siguen siendo solo indicios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähdepäivitysten muistutukset ovat päällä. Yhteisön versiot ovat edelleen vain vihjeitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels de mise à jour de source sont activés. Les versions de la communauté restent de simples indices."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורות לעדכוני מקור פועלות. גרסאות קהילה עדיין נחשבות לרמזים בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत अपडेट रिमाइंडर चालू हैं। समुदाय संस्करणों को अब भी केवल संकेत माना जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici za ažuriranja iz izvora su uključeni. Verzije iz zajednice i dalje su samo savjeti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A forrásfrissítési emlékeztetők be vannak kapcsolva. A közösségi verziók továbbra is csak tippek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat pembaruan sumber aktif. Versi komunitas tetap dianggap hanya sebagai petunjuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria per gli aggiornamenti dalla fonte sono attivi. Le versioni della community restano solo indizi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースのアップデート通知が有効になりました。コミュニティのバージョンは引き続き手がかりとしてのみ扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 업데이트 알림이 켜졌습니다. 커뮤니티 버전은 계속 단서로만 취급됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan kemas kini sumber dihidupkan. Versi komuniti masih dianggap sebagai petunjuk sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser om oppdateringer fra kilder er slått på. Fellesskapsversjoner regnes fortsatt bare som tips."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen voor bronupdates zijn ingeschakeld. Communityversies blijven alleen hints."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia o uaktualnieniach ze źródeł są włączone. Wersje od społeczności nadal są tylko wskazówkami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de atualizações da fonte estão ativados. Versões da comunidade continuam sendo apenas pistas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes de atualizações da fonte estão ativos. As versões da comunidade continuam a ser apenas pistas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mementourile pentru actualizări de la surse sunt activate. Versiunile din comunitate rămân doar indicii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания об обновлениях из источников включены. Версии от сообщества по-прежнему считаются лишь подсказками."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky aktualizácií zo zdrojov sú zapnuté. Verzie od komunity sú naďalej len tipy."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser om källuppdateringar är aktiverade. Communityversioner betraktas fortfarande bara som tips."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการเตือนอัปเดตจากแหล่งแล้ว เวอร์ชันจากชุมชนยังถือเป็นเพียงเบาะแส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak güncelleme hatırlatmaları açık. Topluluk sürümleri yine yalnızca ipucu olarak değerlendirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадування про оновлення з джерел увімкнено. Версії від спільноти й надалі вважаються лише підказками."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bật nhắc cập nhật từ nguồn. Phiên bản cộng đồng vẫn chỉ được xem là manh mối."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源更新提醒已啟用。社群版本仍只作為線索。"
          }
        }
      }
    },
