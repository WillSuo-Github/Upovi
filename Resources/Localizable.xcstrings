    "P2P 已关闭，已缓存的公开记录会按有效期过期": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P متوقف. ستنتهي صلاحية السجلات العامة المخزنة مؤقتًا في موعدها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El P2P està desactivat. Els registres públics a la memòria cau caducaran segons el previst."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P je vypnuto. Veřejné záznamy v mezipaměti vyprší podle plánu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P er slået fra. Cachelagrede offentlige poster udløber som planlagt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P ist aus. Zwischengespeicherte öffentliche Einträge laufen planmäßig ab"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το P2P είναι ανενεργό. Οι δημόσιες εγγραφές στην κρυφή μνήμη λήγουν σύμφωνα με το πρόγραμμα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P is off. Cached public records will expire on schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P desactivado. Los registros públicos en caché caducarán según lo previsto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P on pois päältä. Välimuistissa olevat julkiset tietueet vanhenevat aikataulun mukaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P désactivé. Les enregistrements publics en cache expireront comme prévu"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P כבוי. רשומות ציבוריות שבמטמון יפוגו כמתוכנן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P बंद है। कैश किए गए सार्वजनिक रिकॉर्ड निर्धारित समय पर समाप्त हो जाएँगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P je isključen. Javni zapisi u međuspremniku istječu prema rasporedu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A P2P ki van kapcsolva. A gyorsítótárazott nyilvános rekordok az ütemezés szerint lejárnak"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P nonaktif. Catatan publik yang di-cache akan kedaluwarsa sesuai jadwal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P disattivato. I record pubblici in cache scadranno come previsto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P はオフです。キャッシュされた公開レコードは有効期限で失効します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P 끔. 캐시된 공개 레코드는 유효 기간에 따라 만료됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P dimatikan. Rekod awam dalam cache akan tamat tempoh mengikut jadual."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P er av. Bufrede offentlige oppføringer utløper som planlagt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P is uit. Gecachete openbare records verlopen volgens schema"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P wyłączone. Rekordy publiczne w pamięci podręcznej wygasną zgodnie z planem"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P desativado. Os registros públicos em cache expirarão conforme previsto"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P desativado. Os registos públicos em cache expiram conforme previsto"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P este dezactivat. Înregistrările publice din cache expiră conform planului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P выключен. Кэшированные публичные записи истекут по расписанию"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P je vypnuté. Verejné záznamy vo vyrovnávacej pamäti vyprší podľa plánu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P är av. Cachelagrade offentliga poster upphör enligt schemat"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P ปิดอยู่ ระเบียนสาธารณะที่แคชไว้จะหมดอายุตามกำหนด"
          }
        },
        "tr": {
