    "授权后将检查安装负载的应用身份，再由 Upovi 执行系统安装工具。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد التفويض، يتحقق Upovi من هوية التطبيق في حمولة المثبّت ثم يشغّل مثبّت النظام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Després de l’autorització, Upovi comprova la identitat de l’app al contingut de l’instal·lador i després executa l’instal·lador del sistema."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po autorizaci Upovi zkontroluje identitu aplikace v obsahu balíčku a poté spustí systémový instalační nástroj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter godkendelse kontrollerer Upovi appens identitet i pakkens indhold og kører derefter systemets installationsværktøj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Autorisierung prüft Upovi die App-Kennung im Installationspaket und führt dann das Systeminstallationsprogramm aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετά την εξουσιοδότηση, το Upovi ελέγχει την ταυτότητα της εφαρμογής στο περιεχόμενο του πακέτου και έπειτα εκτελεί το εργαλείο εγκατάστασης του συστήματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After authorization, Upovi checks the app identity in the installer payload and then runs the system installer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras la autorización, Upovi comprueba la identidad de la app en el contenido del instalador y después ejecuta la herramienta de instalación del sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valtuutuksen jälkeen Upovi tarkistaa apin identiteetin paketin sisällöstä ja ajaa sitten järjestelmän asennustyökalun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’autorisation, Upovi vérifie l’identité de l’app dans le contenu du paquet, puis lance l’outil d’installation du système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר ההרשאה, Upovi בודק את זהות היישום בתוכן המתקין ואז מריץ את מתקין המערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राधिकरण के बाद Upovi इंस्टॉलर पेलोड में ऐप पहचान जाँचता है और फिर सिस्टम इंस्टॉलर चलाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon autorizacije Upovi provjerava identitet aplikacije u sadržaju paketa, a zatim pokreće sistemski alat za instalaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezés után az Upovi ellenőrzi az alkalmazás azonosítását a csomag tartalmában, majd futtatja a rendszer telepítőeszközét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setelah otorisasi, Upovi memeriksa identitas app dalam muatan penginstal lalu menjalankan penginstal sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo l’autorizzazione, Upovi controlla l’identità dell’app nel contenuto del pacchetto e poi esegue lo strumento di installazione di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証後、インストーラの内容に含まれる App の識別情報を確認してから、Upovi がシステムのインストールツールを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 후 설치 프로그램 페이로드의 앱 식별 정보를 확인한 다음 Upovi가 시스템 설치 도구를 실행합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selepas kebenaran, Upovi menyemak identiti apl dalam muatan pemasang dan kemudian menjalankan pemasang sistem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etter autorisasjon kontrollerer Upovi appidentiteten i pakkeinnholdet og kjører deretter systemets installeringsverktøy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na autorisatie controleert Upovi de app-identiteit in de pakketinhoud en voert het daarna het installatieprogramma van het systeem uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po autoryzacji Upovi sprawdzi tożsamość aplikacji w zawartości pakietu, a następnie uruchomi systemowe narzędzie instalacyjne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a autorização, o Upovi verifica a identidade do app no conteúdo do pacote e então executa a ferramenta de instalação do sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a autorização, o Upovi verifica a identidade da app no conteúdo do pacote e depois executa a ferramenta de instalação do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După autorizare, Upovi verifică identitatea aplicației din conținutul pachetului, apoi rulează instrumentul de instalare al sistemului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После авторизации Upovi проверит идентичность приложения в содержимом пакета и затем запустит системный инструмент установки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Po autorizácii Upovi skontroluje identitu aplikácie v obsahu balíka a potom spustí systémový inštalačný nástroj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efter auktorisering kontrollerar Upovi appidentiteten i paketets innehåll och kör sedan systemets installationsverktyg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังได้รับอนุญาต Upovi จะตรวจสอบตัวตนของแอปในเพย์โหลดของตัวติดตั้ง แล้วเรียกใช้ตัวติดตั้งของระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yetkilendirmeden sonra Upovi yükleyici yükündeki uygulama kimliğini denetler ve ardından sistem yükleyicisini çalıştırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після авторизації Upovi перевірить ідентичність програми у вмісті пакета, а потім запустить системний інструмент інсталяції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi ủy quyền, Upovi kiểm tra danh tính ứng dụng trong gói cài đặt rồi chạy trình cài đặt của hệ thống."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權後將檢查安裝內容的 App 身分，再由 Upovi 執行系統安裝工具。"
          }
        }
      }
    },
