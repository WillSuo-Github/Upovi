    "P2P 已开启，扫描到应用后会自动参与": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P يعمل وسينضم تلقائيًا بعد فحص التطبيقات"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El P2P està activat i s’hi unirà automàticament quan s’escanegin les apps"
          }
        },
        "cs": {
          "stringUnit": {
