    "服务器拒绝了请求，未确认是否有更新（HTTP 403）": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الخادم الطلب؛ لم يتم التأكد من وجود تحديث (HTTP 403)"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ha rebutjat la sol·licitud; no s’ha confirmat si hi ha cap actualització (HTTP 403)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odmítl požadavek; dostupnost aktualizace není potvrzena (HTTP 403)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren afviste anmodningen; om der findes en opdatering, er ikke bekræftet (HTTP 403)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage abgelehnt; ob ein Update vorliegt, ist unbestätigt (HTTP 403)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής απέρριψε το αίτημα· δεν έχει επιβεβαιωθεί αν υπάρχει ενημέρωση (HTTP 403)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server refused the request; whether an update exists is unconfirmed (HTTP 403)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la solicitud; no se ha confirmado si hay una actualización (HTTP 403)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin hylkäsi pyynnön; päivityksen olemassaoloa ei ole vahvistettu (HTTP 403)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé la requête ; l’existence d’une mise à jour n’est pas confirmée (HTTP 403)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת דחה את הבקשה; לא אושר אם קיים עדכון (HTTP 403)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने अनुरोध अस्वीकार किया; अपडेट है या नहीं, इसकी पुष्टि नहीं हुई है (HTTP 403)"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslužitelj je odbio zahtjev; nije potvrđeno postoji li ažuriranje (HTTP 403)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiszolgáló elutasította a kérést; nincs megerősítve, hogy van-e frissítés (HTTP 403)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server menolak permintaan; ada tidaknya pembaruan belum dikonfirmasi (HTTP 403)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha rifiutato la richiesta; la presenza di un aggiornamento non è confermata (HTTP 403)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがリクエストを拒否しました。アップデートの有無は未確認です（HTTP 403）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 요청을 거부했습니다. 업데이트 여부는 확인되지 않았습니다(HTTP 403)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan menolak permintaan; sama ada kemas kini wujud belum disahkan (HTTP 403)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjeneren avviste forespørselen; om det finnes en oppdatering, er ikke bekreftet (HTTP 403)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server weigerde het verzoek; of er een update is, is niet bevestigd (HTTP 403)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer odrzucił żądanie; dostępność uaktualnienia nie jest potwierdzona (HTTP 403)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou a solicitação; não foi confirmado se há atualização (HTTP 403)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor recusou o pedido; não está confirmado se existe atualização (HTTP 403)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul a refuzat solicitarea; nu este confirmat dacă există o actualizare (HTTP 403)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отклонил запрос; наличие обновления не подтверждено (HTTP 403)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Server odmietol požiadavku; dostupnosť aktualizácie nie je potvrdená (HTTP 403)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern avvisade begäran; om det finns en uppdatering är inte bekräftat (HTTP 403)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซิร์ฟเวอร์ปฏิเสธคำขอ ยังไม่ยืนยันว่ามีอัปเดตหรือไม่ (HTTP 403)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu isteği reddetti; güncelleme olup olmadığı doğrulanmadı (HTTP 403)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер відхилив запит; наявність оновлення не підтверджено (HTTP 403)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ từ chối yêu cầu; chưa xác nhận có bản cập nhật hay không (HTTP 403)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕了請求，未確認是否有更新（HTTP 403）"
          }
        }
      }
    },
    "服务器未能提供安装包，请稍后重新检测来源。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يوفّر الخادم المثبّت. أعد فحص المصدر لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha proporcionat l’instal·lador. Torna a comprovar la font més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server neposkytl instalátor. Zdroj zkontrolujte znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren leverede ikke installationsprogrammet. Kontroller kilden igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat das Installationsprogramm nicht bereitgestellt. Prüfe die Quelle später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν παρείχε το πρόγραμμα εγκατάστασης. Ελέγξτε ξανά την πηγή αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server didn’t provide the installer. Recheck the source later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no proporcionó el instalador. Vuelve a comprobar la fuente más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei toimittanut asentajaa. Tarkista lähde myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas fourni le programme d’installation. Revérifiez la source plus tard."
