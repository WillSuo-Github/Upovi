    "通知权限未开启，可在系统设置中允许 Upovi 通知。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الإشعارات متوقف. اسمح بإشعارات Upovi في إعدادات النظام."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El permís de notificacions està desactivat. Permet les notificacions d’Upovi a la Configuració del Sistema."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení nejsou povolena. Povolte oznámení Upovi v Nastavení systému."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelelser er ikke tilladt. Tillad meddelelser fra Upovi i Systemindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind nicht erlaubt. Erlaube Mitteilungen für Upovi in den Systemeinstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις δεν επιτρέπονται. Επιτρέψτε τις ειδοποιήσεις του Upovi στις Ρυθμίσεις συστήματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification permission is off. Allow notifications for Upovi in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones no están permitidas. Permite las notificaciones de Upovi en Ajustes del Sistema."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset eivät ole sallittuja. Salli Upovin ilmoitukset Järjestelmäasetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications ne sont pas autorisées. Autorisez les notifications d’Upovi dans Réglages Système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרשאת ההודעות כבויה. אפשר הודעות עבור Upovi בהגדרות המערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना अनुमति बंद है। सिस्टम सेटिंग्स में Upovi के लिए सूचनाओं की अनुमति दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti nisu dopuštene. Dopustite obavijesti aplikacije Upovi u Postavkama sustava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések nincsenek engedélyezve. Engedélyezze az Upovi értesítéseit a Rendszerbeállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin notifikasi nonaktif. Izinkan notifikasi untuk Upovi di Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche non sono consentite. Consenti le notifiche di Upovi in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の許可がオフです。システム設定で Upovi の通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 권한이 꺼져 있습니다. 시스템 설정에서 Upovi 알림을 허용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebenaran pemberitahuan dimatikan. Benarkan pemberitahuan untuk Upovi dalam Tetapan Sistem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er ikke tillatt. Tillat varsler fra Upovi i Systeminnstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen zijn niet toegestaan. Sta meldingen voor Upovi toe in Systeeminstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia nie są dozwolone. Zezwól na powiadomienia Upovi w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações não estão permitidas. Permita notificações do Upovi nos Ajustes do Sistema."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações não estão permitidas. Permita as notificações do Upovi nas Definições do Sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările nu sunt permise. Permiteți notificările Upovi în Configurări sistem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления не разрешены. Разрешите уведомления Upovi в Системных настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikácie nie sú povolené. Povoľte notifikácie Upovi v Systémových nastaveniach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är inte tillåtna. Tillåt notiser för Upovi i Systeminställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์การแจ้งเตือนปิดอยู่ โปรดอนุญาตการแจ้งเตือนสำหรับ Upovi ในการตั้งค่าระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim izni kapalı. Sistem Ayarları’nda Upovi için bildirimlere izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення не дозволено. Дозвольте сповіщення Upovi в Системних параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền thông báo đang tắt. Hãy cho phép thông báo của Upovi trong Cài đặt hệ thống."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知權限未開啟，可在系統設定中允許 Upovi 通知。"
          }
        }
      }
    },
    "通过 Upovi 下载并验证的更新安装后会出现在这里。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا التحديثات التي نزّلها Upovi وتحقق منها بعد تثبيتها."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actualitzacions descarregades i verificades per Upovi apareixen aquí després d’instal·lar-les."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace stažené a ověřené aplikací Upovi se zde zobrazí po instalaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdateringer, der er hentet og kontrolleret af Upovi, vises her efter installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Upovi geladene und geprüfte Updates erscheinen nach der Installation hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ενημερώσεις που λήφθηκαν και επαληθεύτηκαν από το Upovi εμφανίζονται εδώ μετά την εγκατάσταση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates downloaded and verified by Upovi appear here after installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones descargadas y verificadas por Upovi aparecen aquí tras instalarse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovin lataamat ja tarkistamat päivitykset näkyvät täällä asennuksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour téléchargées et vérifiées par Upovi apparaissent ici après installation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכונים ש-Upovi הוריד ואימת יופיעו כאן לאחר ההתקנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi द्वारा डाउनलोड और सत्यापित अपडेट इंस्टॉल होने के बाद यहाँ दिखाई देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ažuriranja koja je Upovi preuzeo i provjerio pojavit će se ovdje nakon instalacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Upovi által letöltött és ellenőrzött frissítések telepítés után itt jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan yang diunduh dan diverifikasi oleh Upovi muncul di sini setelah diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti scaricati e verificati da Upovi appaiono qui dopo l’installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi でダウンロードして検証したアップデートは、インストール後にここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi에서 다운로드하고 확인한 업데이트는 설치 후 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas kini yang dimuat turun dan disahkan oleh Upovi muncul di sini selepas dipasang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdateringer som er lastet ned og kontrollert av Upovi, vises her etter installering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates die door Upovi zijn gedownload en gecontroleerd, verschijnen hier na installatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uaktualnienia pobrane i zweryfikowane przez Upovi pojawią się tutaj po instalacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações baixadas e verificadas pelo Upovi aparecem aqui após a instalação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações transferidas e verificadas pelo Upovi aparecem aqui após a instalação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizările descărcate și verificate de Upovi apar aici după instalare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления, загруженные и проверенные Upovi, появятся здесь после установки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizácie stiahnuté a overené aplikáciou Upovi sa tu zobrazia po inštalácii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppdateringar som hämtats och verifierats av Upovi visas här efter installation."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตที่ Upovi ดาวน์โหลดและตรวจสอบจะแสดงที่นี่หลังติดตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi tarafından indirilip doğrulanan güncellemeler yüklendikten sonra burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення, завантажені й перевірені Upovi, з’являться тут після інсталяції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản cập nhật được Upovi tải về và xác minh sẽ xuất hiện tại đây sau khi cài đặt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Upovi 下載並驗證的更新安裝後會出現在這裡。"
          }
        }
      }
    },
    "部分或全部来源没有返回有效结果，原因见下方“检测来源”。可以稍后重新检查，或在帮助菜单导出诊断报告。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع بعض المصادر أو كلها نتائج صالحة؛ راجع «مصادر الفحص» أدناه للتفاصيل. أعد الفحص لاحقًا، أو صدّر تقرير تشخيص من قائمة المساعدة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunes fonts o totes no han retornat resultats vàlids; consulta «Fonts comprovades» a sota per als detalls. Torna a comprovar més tard o exporta un informe de diagnòstic des del menú Ajuda."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé nebo všechny zdroje nevrátily platné výsledky; podrobnosti viz „Zkontrolované zdroje“ níže. Zkontrolujte znovu později nebo exportujte diagnostickou zprávu z nabídky Nápověda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle eller alle kilder returnerede ingen gyldige resultater; se “Kontrollerede kilder” nedenfor. Kontroller igen senere, eller eksporter en diagnosticeringsrapport fra menuen Hjælp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige oder alle Quellen lieferten keine gültigen Ergebnisse; Details unter „Geprüfte Quellen“. Prüfe später erneut oder exportiere einen Diagnosebericht über das Menü „Hilfe“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες ή όλες οι πηγές δεν επέστρεψαν έγκυρα αποτελέσματα· δείτε τις «Ελεγμένες πηγές» παρακάτω. Ελέγξτε ξανά αργότερα ή εξαγάγετε αναφορά διαγνωστικών από το μενού Βοήθεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some or all sources returned no valid results; see “Check Sources” below for details. Check again later, or export a diagnostic report from the Help menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas fuentes o todas no devolvieron resultados válidos; consulta «Fuentes comprobadas» más abajo. Vuelve a comprobar más tarde o exporta un informe de diagnóstico desde el menú Ayuda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osa lähteistä tai kaikki lähteet eivät palauttaneet kelvollisia tuloksia; katso alla oleva kohta ”Tarkistetut lähteet”. Tarkista myöhemmin uudelleen tai vie diagnostiikkaraportti Ohje-valikosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines sources ou toutes n’ont renvoyé aucun résultat valide ; voir « Sources vérifiées » ci-dessous. Revérifiez plus tard ou exportez un rapport de diagnostic depuis le menu Aide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק מהמקורות או כולם לא החזירו תוצאות תקינות; לפרטים ראה „מקורות הבדיקה” למטה. בדוק שוב מאוחר יותר, או ייצא דוח אבחון מתפריט העזרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ या सभी स्रोतों ने मान्य परिणाम नहीं लौटाए; विवरण के लिए नीचे “जाँच स्रोत” देखें। बाद में फिर से जाँचें, या सहायता मेनू से निदान रिपोर्ट निर्यात करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki ili svi izvori nisu vratili valjane rezultate; pojedinosti potražite u odjeljku „Provjereni izvori” u nastavku. Ponovno provjerite kasnije ili izvezite dijagnostičko izvješće iz izbornika Pomoć."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány vagy az összes forrás nem adott érvényes eredményt; részletek lent az „Ellenőrzött források” részen. Ellenőrizzen később, vagy exportáljon diagnosztikai jelentést a Súgó menüből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian atau semua sumber tidak mengembalikan hasil yang valid; lihat “Sumber Pemeriksaan” di bawah untuk detailnya. Periksa lagi nanti, atau ekspor laporan diagnostik dari menu Bantuan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune fonti o tutte non hanno restituito risultati validi; vedi «Fonti controllate» qui sotto. Ricontrolla più tardi o esporta un rapporto di diagnostica dal menu Aiuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部またはすべてのソースから有効な結果が返されませんでした。理由は下の「確認したソース」を参照してください。あとで再確認するか、ヘルプメニューから診断レポートを書き出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 또는 모든 소스에서 유효한 결과를 반환하지 않았습니다. 이유는 아래 ‘확인 소스’를 참조하십시오. 나중에 다시 확인하거나 도움말 메뉴에서 진단 보고서를 내보낼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebahagian atau semua sumber tidak memulangkan keputusan yang sah; lihat “Sumber Semakan” di bawah untuk butiran. Semak lagi kemudian, atau eksport laporan diagnostik daripada menu Bantuan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen eller alle kilder returnerte ingen gyldige resultater; se «Kontrollerte kilder» nedenfor. Kontroller på nytt senere, eller eksporter en diagnoserapport fra Hjelp-menyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige of alle bronnen gaven geen geldige resultaten; zie 'Gecontroleerde bronnen' hieronder. Controleer later opnieuw of exporteer een diagnostisch rapport via het menu Help."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre lub wszystkie źródła nie zwróciły prawidłowych wyników; szczegóły w sekcji „Sprawdzone źródła” poniżej. Sprawdź ponownie później lub wyeksportuj raport diagnostyczny z menu Pomoc."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas ou todas as fontes não retornaram resultados válidos; veja “Fontes Verificadas” abaixo. Verifique novamente mais tarde ou exporte um relatório de diagnóstico no menu Ajuda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas ou todas as fontes não devolveram resultados válidos; consulte “Fontes verificadas” abaixo. Volte a verificar mais tarde ou exporte um relatório de diagnóstico a partir do menu Ajuda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unele sau toate sursele nu au returnat rezultate valide; consultați „Surse verificate” mai jos. Verificați din nou mai târziu sau exportați un raport de diagnosticare din meniul Ajutor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые или все источники не вернули действительных результатов; подробности в разделе «Проверенные источники» ниже. Проверьте позже или экспортируйте диагностический отчёт из меню «Справка»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektoré alebo všetky zdroje nevrátili platné výsledky; podrobnosti nájdete v časti „Skontrolované zdroje“ nižšie. Skontrolujte znova neskôr alebo exportujte diagnostickú správu z ponuky Pomocník."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa eller alla källor returnerade inga giltiga resultat; se ”Kontrollerade källor” nedan. Kontrollera igen senare eller exportera en diagnostikrapport från Hjälp-menyn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แหล่งบางส่วนหรือทั้งหมดไม่ส่งคืนผลลัพธ์ที่ถูกต้อง ดูรายละเอียดใน “แหล่งที่ตรวจสอบ” ด้านล่าง ตรวจสอบอีกครั้งในภายหลัง หรือส่งออกรายงานการวินิจฉัยจากเมนูวิธีใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynakların bir kısmı veya tümü geçerli sonuç döndürmedi; ayrıntılar için aşağıdaki “Denetim Kaynakları”na bakın. Daha sonra yeniden denetleyin veya Yardım menüsünden bir tanılama raporu dışa aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі або всі джерела не повернули дійсних результатів; подробиці в розділі «Перевірені джерела» нижче. Перевірте пізніше або експортуйте звіт діагностики з меню «Довідка»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số hoặc tất cả nguồn không trả về kết quả hợp lệ; xem “Nguồn kiểm tra” bên dưới để biết chi tiết. Hãy kiểm tra lại sau, hoặc xuất báo cáo chẩn đoán từ menu Trợ giúp."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分或全部來源沒有傳回有效結果，原因見下方「檢查來源」。可以稍後重新檢查，或在輔助說明選單匯出診斷報告。"
          }
        }
      }
    },
