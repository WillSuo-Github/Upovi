          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi prehľadá /Applications a ~/Applications a potom porovná verzie so Sparkle, Homebrew, GitHubom a App Storom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi skannar /Applications och ~/Applications och jämför sedan versionerna med Sparkle, Homebrew, GitHub och App Store."
          }
        },
        "th": {
          "stringUnit": {
