    "由 Upovi 发起商店更新，可能需要 Apple 账户认证；不提供旧版备份或暂停。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ Upovi تحديثات App Store، وقد يتطلب ذلك المصادقة بحساب Apple؛ دون نسخة احتياطية للإصدار القديم أو إيقاف مؤقت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi inicia les actualitzacions de l’App Store, que poden requerir autenticació del compte d’Apple; sense còpia de la versió antiga ni pausa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi spouští aktualizace App Storu, což může vyžadovat přihlášení účtem Apple; bez zálohy staré verze a bez pozastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi starter App Store-opdateringer, hvilket kan kræve login med Apple-konto; ingen sikkerhedskopi af den gamle version og ingen pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi startet App Store-Updates; eine Anmeldung mit dem Apple Account kann nötig sein. Kein Backup der alten Version und kein Pausieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Upovi ξεκινά ενημερώσεις App Store, κάτι που ίσως απαιτεί σύνδεση με λογαριασμό Apple· χωρίς εφεδρικό αντίγραφο της παλιάς έκδοσης και χωρίς παύση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi starts App Store updates, which may require Apple Account authentication; no backup of the old version or pausing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi inicia las actualizaciones del App Store, que pueden requerir autenticación de Apple; sin copia de la versión anterior ni pausa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi käynnistää App Store -päivitykset, mikä voi vaatia kirjautumista Apple-tilillä; ei vanhan version varmuuskopiota eikä keskeytystä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi lance les mises à jour App Store, ce qui peut nécessiter une authentification Apple ; pas de sauvegarde de l’ancienne version ni de pause."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi מתחיל עדכוני App Store, שעשויים לדרוש אימות חשבון Apple; ללא גיבוי של הגרסה הישנה וללא השהיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi App Store अपडेट शुरू करता है, जिसके लिए Apple खाता प्रमाणीकरण आवश्यक हो सकता है; पुराने संस्करण का बैकअप या विराम उपलब्ध नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi pokreće ažuriranja App Storea, što može zahtijevati prijavu Apple računom; bez sigurnosne kopije stare verzije i bez pauze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Upovi App Store-frissítéseket indít, amelyek Apple-fiókos hitelesítést igényelhetnek; nincs biztonsági másolat a régi verzióról és nincs szüneteltetés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi memulai pembaruan App Store, yang mungkin memerlukan autentikasi Akun Apple; tanpa cadangan versi lama atau jeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi avvia gli aggiornamenti App Store, che possono richiedere l’autenticazione Apple; nessun backup della versione precedente né pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi が App Store のアップデートを開始します。Apple アカウントの認証が必要な場合があり、旧バージョンのバックアップや一時停止はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi가 App Store 업데이트를 시작하며 Apple 계정 인증이 필요할 수 있습니다. 이전 버전 백업이나 일시 정지는 제공되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi memulakan kemas kini App Store, yang mungkin memerlukan pengesahan Akaun Apple; tiada sandaran versi lama atau jeda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi starter App Store-oppdateringer, noe som kan kreve pålogging med Apple-konto; ingen sikkerhetskopi av den gamle versjonen og ingen pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi start App Store-updates, waarvoor inloggen met je Apple Account nodig kan zijn; geen reservekopie van de oude versie en geen pauze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi uruchamia uaktualnienia App Store, które mogą wymagać uwierzytelnienia kontem Apple; bez kopii poprzedniej wersji i wstrzymywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Upovi inicia atualizações da App Store, que podem exigir autenticação da Conta Apple; sem backup da versão anterior nem pausa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Upovi inicia as atualizações da App Store, que podem requerer autenticação da Conta Apple; sem cópia da versão anterior nem pausa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi pornește actualizări App Store, care pot necesita autentificarea cu contul Apple; fără copie de rezervă a versiunii vechi și fără pauză."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi запускает обновления App Store, для которых может потребоваться вход в Аккаунт Apple; без резервной копии старой версии и паузы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi spúšťa aktualizácie App Storu, čo môže vyžadovať prihlásenie účtom Apple; bez zálohy starej verzie a bez pozastavenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi startar App Store-uppdateringar, vilket kan kräva inloggning med Apple-konto; ingen säkerhetskopia av den gamla versionen och ingen paus."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi เริ่มอัปเดต App Store ซึ่งอาจต้องยืนยันตัวตนด้วยบัญชี Apple ไม่มีข้อมูลสำรองเวอร์ชันเก่าหรือการหยุดชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi App Store güncellemelerini başlatır; Apple Hesabı kimlik doğrulaması gerekebilir; eski sürüm yedeği veya duraklatma yoktur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi запускає оновлення App Store, для яких може знадобитися вхід в обліковий запис Apple; без резервної копії старої версії та паузи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi khởi động cập nhật App Store, có thể yêu cầu xác thực Tài khoản Apple; không có bản sao lưu phiên bản cũ hay tạm dừng."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Upovi 發起商店更新，可能需要 Apple 帳號驗證；不提供舊版備份或暫停。"
          }
        }
      }
    },
    "登录启动设置未完成：%@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل إعداد التشغيل عند تسجيل الدخول: %@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
