    "应用已重新扫描；当前没有可用网络，联网后再检查更新。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعيد فحص التطبيقات، لكن لا تتوفر شبكة. افحص التحديثات عند الاتصال بالإنترنت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’han tornat a escanejar les apps, però no hi ha xarxa. Comprova les actualitzacions quan tinguis connexió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace byly znovu prohledány, ale síť není dostupná. Zkontrolujte aktualizace, až budete online."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps blev scannet igen, men der er intet netværk. Søg efter opdateringer, når du er online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps wurden neu gescannt, aber es ist kein Netzwerk verfügbar. Suche nach Updates, sobald du online bist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι εφαρμογές σαρώθηκαν ξανά, αλλά δεν υπάρχει δίκτυο. Ελέγξτε για ενημερώσεις όταν συνδεθείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps were rescanned, but no network is available. Check for updates once you’re online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volvieron a analizar las apps, pero no hay red. Busca actualizaciones cuando estés conectado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Appit skannattiin uudelleen, mutta verkkoa ei ole. Tarkista päivitykset, kun olet verkossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ont été réanalysées, mais aucun réseau n’est disponible. Vérifiez les mises à jour une fois en ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישומים נסרקו מחדש, אך אין רשת זמינה. בדוק עדכונים כשתהיה מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप फिर से स्कैन किए गए, लेकिन कोई नेटवर्क उपलब्ध नहीं है। ऑनलाइन होने पर अपडेट जाँचें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacije su ponovno skenirane, ali mreža nije dostupna. Provjerite ažuriranja kad budete na mreži."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazások újra beolvasva, de nincs hálózat. Keressen frissítéseket, amikor online lesz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "App telah dipindai ulang, tetapi tidak ada jaringan. Periksa pembaruan setelah Anda online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app sono state analizzate di nuovo, ma non c’è rete. Controlla gli aggiornamenti quando sei online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App を再スキャンしましたが、ネットワークに接続できません。オンラインになってからアップデートを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 다시 스캔했지만 사용 가능한 네트워크가 없습니다. 온라인 상태가 되면 업데이트를 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apl telah diimbas semula, tetapi tiada rangkaian. Semak kemas kini apabila anda dalam talian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appene ble skannet på nytt, men det finnes ikke noe nettverk. Se etter oppdateringer når du er tilkoblet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps zijn opnieuw gescand, maar er is geen netwerk. Controleer op updates zodra je online bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacje przeskanowano ponownie, ale sieć jest niedostępna. Sprawdź uaktualnienia po połączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps foram analisados novamente, mas não há rede. Verifique atualizações quando estiver online."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As apps foram analisadas novamente, mas não há rede. Verifique as atualizações quando estiver online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicațiile au fost scanate din nou, dar nu există rețea. Căutați actualizări când sunteți online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения пересканированы, но сеть недоступна. Проверьте обновления, когда появится подключение."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikácie boli znova prehľadané, ale sieť nie je dostupná. Skontrolujte aktualizácie, keď budete online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparna skannades om, men det finns inget nätverk. Sök efter uppdateringar när du är online."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนแอปใหม่แล้ว แต่ไม่มีเครือข่าย โปรดตรวจสอบอัปเดตเมื่อออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar yeniden tarandı ancak ağ yok. Çevrimiçi olduğunuzda güncellemeleri denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програми проскановано знову, але мережа недоступна. Перевірте оновлення, коли з’явиться підключення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã quét lại ứng dụng nhưng không có mạng. Hãy kiểm tra cập nhật khi đã trực tuyến."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 已重新掃描；目前沒有可用網路，連線後再檢查更新。"
          }
        }
      }
    },
