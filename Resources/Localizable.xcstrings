          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể bỏ qua lời nhắc cập nhật từ menu ngữ cảnh hoặc chi tiết của ứng dụng."
          }
        },
        "zh-Hant": {
