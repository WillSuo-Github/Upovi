        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav čistenia nie je potvrdený; najprv skontrolujte záznam správcu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensningsstatus ej bekräftad; kontrollera administratörsposten först"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ยืนยันสถานะการล้าง โปรดตรวจสอบบันทึกของผู้ดูแลระบบก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temizleme durumu doğrulanmadı; önce yönetici kaydını doğrulayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан очищення не підтверджено; спершу перевірте запис адміністратора"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác nhận trạng thái dọn dẹp; hãy đối chiếu bản ghi quản trị viên trước"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理狀態尚未確認，請先核對管理者記錄"
          }
        }
      }
    },
    "点击工具栏中的“刷新并检查”开始扫描。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر على «تحديث القائمة والفحص» في شريط الأدوات لبدء الفحص."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes clic a «Actualitza i comprova» a la barra d’eines per començar l’escaneig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na „Obnovit a zkontrolovat“ na panelu nástrojů a spusťte prohledávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på “Opdater og kontroller” på værktøjslinjen for at starte scanningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Symbolleiste auf „Aktualisieren und prüfen“, um den Scan zu starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο «Ανανέωση και έλεγχος» στη γραμμή εργαλείων για να ξεκινήσει η σάρωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “Refresh and Check” in the toolbar to start scanning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «Actualizar y comprobar» en la barra de herramientas para empezar a analizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita skannaus osoittamalla työkalupalkin ”Päivitä ja tarkista”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « Actualiser et vérifier » dans la barre d’outils pour lancer l’analyse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על „רענן ובדוק” בסרגל הכלים כדי להתחיל בסריקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन शुरू करने के लिए टूलबार में “रीफ़्रेश करें और जाँचें” पर क्लिक करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite „Osvježi i provjeri” na alatnoj traci za početak skeniranja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beolvasás indításához kattintson az eszközsor „Frissítés és ellenőrzés” gombjára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik “Segarkan dan Periksa” di bar alat untuk mulai memindai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su «Aggiorna e controlla» nella barra degli strumenti per avviare la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールバーの「更新して確認」をクリックしてスキャンを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 막대에서 ‘새로 고침 및 확인’을 클릭하여 스캔을 시작하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik “Segar Semula dan Semak” dalam bar alat untuk mula mengimbas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på «Oppdater og kontroller» i verktøylinjen for å starte skanningen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op 'Vernieuw en controleer' in de knoppenbalk om te beginnen met scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „Odśwież i sprawdź” na pasku narzędzi, aby rozpocząć skanowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em “Atualizar e Verificar” na barra de ferramentas para começar a análise."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em “Atualizar e verificar” na barra de ferramentas para iniciar a análise."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe „Reîmprospătează și verifică” din bara de instrumente pentru a începe scanarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Обновить и проверить» на панели инструментов, чтобы начать сканирование."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknite na „Obnoviť a skontrolovať“ na paneli s nástrojmi a spustite prehľadávanie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ”Uppdatera och kontrollera” i verktygsfältet för att börja skanna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิก “รีเฟรชและตรวจสอบ” ในแถบเครื่องมือเพื่อเริ่มสแกน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taramayı başlatmak için araç çubuğundaki “Yenile ve Denetle”yi tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть «Оновити й перевірити» на панелі інструментів, щоб почати сканування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm “Làm mới và kiểm tra” trên thanh công cụ để bắt đầu quét."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下工具列中的「重新整理並檢查」開始掃描。"
          }
        }
      }
    },
