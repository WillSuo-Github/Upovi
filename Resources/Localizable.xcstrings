    "重新扫描全部应用，然后检查全部应用的更新（⌘R）": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة فحص كل التطبيقات، ثم البحث عن تحديثات لها جميعًا (⌘R)"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a escanejar totes les apps i després comprova’n les actualitzacions (⌘R)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu prohledat všechny aplikace a poté u všech zkontrolovat aktualizace (⌘R)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan alle apps igen, og søg derefter efter opdateringer til dem alle (⌘R)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Apps neu scannen und dann alle nach Updates durchsuchen (⌘R)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Νέα σάρωση όλων των εφαρμογών και έλεγχος όλων για ενημερώσεις (⌘R)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescan all apps, then check all of them for updates (⌘R)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a analizar todas las apps y buscar sus actualizaciones (⌘R)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa kaikki appit uudelleen ja tarkista sitten kaikkien päivitykset (⌘R)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réanalyser toutes les apps, puis rechercher leurs mises à jour (⌘R)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרוק מחדש את כל היישומים, ואז בדוק עדכונים לכולם (⌘R)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी ऐप फिर से स्कैन करें, फिर सभी के अपडेट जाँचें (⌘R)"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno skeniraj sve aplikacije, a zatim provjeri ažuriranja za sve (⌘R)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Összes alkalmazás újraolvasása, majd mindegyik frissítéseinek keresése (⌘R)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai ulang semua app, lalu periksa pembaruan untuk semuanya (⌘R)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza di nuovo tutte le app e controllane gli aggiornamenti (⌘R)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての App を再スキャンし、すべての App のアップデートを確認（⌘R）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 앱을 다시 스캔한 후 모든 앱의 업데이트 확인(⌘R)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbas semula semua apl, kemudian semak kemas kini untuk kesemuanya (⌘R)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann alle apper på nytt, og se deretter etter oppdateringer for alle (⌘R)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan alle apps opnieuw en zoek daarna voor alle naar updates (⌘R)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie przeskanuj wszystkie aplikacje, a następnie sprawdź uaktualnienia wszystkich (⌘R)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisar novamente todos os apps e verificar as atualizações de todos (⌘R)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisar novamente todas as apps e procurar as respetivas atualizações (⌘R)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescanează toate aplicațiile, apoi caută actualizări pentru toate (⌘R)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пересканировать все приложения, затем проверить обновления для всех (⌘R)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova prehľadať všetky aplikácie a potom pri všetkých skontrolovať aktualizácie (⌘R)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna om alla appar och sök sedan efter uppdateringar för alla (⌘R)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนแอปทั้งหมดใหม่ แล้วตรวจหาอัปเดตของทุกแอป (⌘R)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm uygulamaları yeniden tara, ardından hepsinin güncellemelerini denetle (⌘R)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просканувати всі програми знову, а потім перевірити оновлення для всіх (⌘R)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét lại mọi ứng dụng, rồi kiểm tra cập nhật cho tất cả (⌘R)"
