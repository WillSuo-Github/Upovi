    "请使用包含商店更新组件的 Developer ID 签名 Upovi 应用包。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حزمة تطبيق Upovi موقّعة بـ Developer ID وتتضمن مكوّنات تحديث App Store."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilitza un paquet de l’app Upovi signat amb Developer ID que inclogui els components d’actualització de l’App Store."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
