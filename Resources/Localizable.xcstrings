    "应用自身的数据格式可能不支持降级，请先保存工作。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا يدعم تنسيق بيانات التطبيق الرجوع إلى إصدار أقدم. احفظ عملك أولًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El format de dades de l’app pot no admetre tornar a una versió anterior. Desa primer la feina."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Datový formát aplikace nemusí podporovat návrat ke starší verzi. Nejdříve uložte svou práci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens dataformat understøtter muligvis ikke nedgradering. Gem dit arbejde først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Datenformat der App unterstützt eventuell kein Downgrade. Sichere zuerst deine Arbeit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μορφή δεδομένων της εφαρμογής ίσως δεν υποστηρίζει επιστροφή σε παλαιότερη έκδοση. Αποθηκεύστε πρώτα την εργασία σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app’s data format may not support downgrading. Save your work first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que el formato de datos de la app no admita volver a una versión anterior. Guarda primero tu trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apin datamuoto ei ehkä tue vanhempaan versioon palaamista. Tallenna työsi ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format de données de l’app peut ne pas prendre en charge le retour à une version antérieure. Enregistrez d’abord votre travail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שפורמט הנתונים של היישום אינו תומך בחזרה לגרסה קודמת. שמור תחילה את העבודה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है ऐप का डेटा प्रारूप पुराने संस्करण पर लौटने का समर्थन न करे। पहले अपना काम सहेजें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format podataka aplikacije možda ne podržava vraćanje na stariju verziju. Najprije spremite svoj rad."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előfordulhat, hogy az alkalmazás adatformátuma nem támogatja a korábbi verzióra való visszatérést. Előbb mentse a munkáját."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format data app mungkin tidak mendukung penurunan versi. Simpan pekerjaan Anda terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato dei dati dell’app potrebbe non supportare il ritorno a una versione precedente. Salva prima il tuo lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のデータ形式がダウングレードに対応していない場合があります。先に作業を保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 데이터 형식이 다운그레이드를 지원하지 않을 수 있습니다. 먼저 작업을 저장하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Format data apl mungkin tidak menyokong turun taraf. Simpan kerja anda dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens dataformat støtter kanskje ikke nedgradering. Arkiver arbeidet ditt først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gegevensformaat van de app ondersteunt mogelijk geen downgrade. Bewaar eerst je werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Format danych aplikacji może nie obsługiwać powrotu do starszej wersji. Najpierw zachowaj swoją pracę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato de dados do app pode não aceitar voltar a uma versão anterior. Salve seu trabalho antes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato de dados da app pode não suportar regressar a uma versão anterior. Guarde primeiro o seu trabalho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatul de date al aplicației poate să nu permită revenirea la o versiune mai veche. Salvați mai întâi munca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат данных приложения может не поддерживать откат версии. Сначала сохраните работу."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Formát údajov aplikácie nemusí podporovať návrat k staršej verzii. Najprv uložte svoju prácu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appens dataformat kanske inte stöder nedgradering. Spara ditt arbete först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปแบบข้อมูลของแอปอาจไม่รองรับการดาวน์เกรด โปรดบันทึกงานของคุณก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın veri biçimi eski sürüme dönmeyi desteklemeyebilir. Önce çalışmanızı kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Формат даних програми може не підтримувати повернення до старішої версії. Спершу збережіть роботу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng dữ liệu của ứng dụng có thể không hỗ trợ hạ cấp. Hãy lưu công việc trước."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 本身的資料格式可能不支援降級，請先儲存工作。"
          }
        }
      }
    },
    "应用运行时定时检查更新": {
      "localizations": {
        "ar": {
          "stringUnit": {
