    "暂时没有比本机更高的社区版本报告。没有线索不代表应用已经最新。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تقارير من المجتمع عن إصدارات أحدث من إصدارك بعد. عدم وجود تلميحات لا يعني أن التطبيق محدَّث."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha informes de la comunitat de versions més noves que la teva. No tenir pistes no vol dir que l’app estigui actualitzada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunita zatím nehlásí novější verze než vaše. Absence tipů neznamená, že je aplikace aktuální."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen rapporter fra fællesskabet om nyere versioner end din endnu. Ingen tip betyder ikke, at appen er opdateret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Community-Berichte über neuere Versionen. Fehlende Hinweise bedeuten nicht, dass die App aktuell ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κοινότητα δεν έχει αναφέρει ακόμη νεότερες εκδόσεις από τη δική σας. Η απουσία ενδείξεων δεν σημαίνει ότι η εφαρμογή είναι ενημερωμένη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No community reports of versions newer than yours yet. No leads doesn’t mean the app is up to date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay informes de la comunidad sobre versiones más recientes que la tuya. No tener indicios no significa que la app esté actualizada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteisö ei ole vielä raportoinut omaasi uudempia versioita. Vihjeiden puuttuminen ei tarkoita, että appi on ajan tasalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun rapport de la communauté sur une version plus récente que la vôtre. L’absence d’indice ne signifie pas que l’app est à jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין דיווחים מהקהילה על גרסאות חדשות יותר משלך. היעדר רמזים אינו אומר שהיישום מעודכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके संस्करण से नए संस्करणों की अभी कोई समुदाय रिपोर्ट नहीं है। संकेत न होने का अर्थ यह नहीं कि ऐप नवीनतम है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajednica još nije prijavila novije verzije od vaše. Izostanak savjeta ne znači da je aplikacija ažurna."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs közösségi jelentés az Önénél újabb verzióról. A tippek hiánya nem jelenti, hogy az alkalmazás naprakész."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada laporan komunitas tentang versi yang lebih baru dari milik Anda. Tidak ada petunjuk bukan berarti app sudah terbaru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun rapporto della community su versioni più recenti della tua. L’assenza di indizi non significa che l’app sia aggiornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac より新しいコミュニティのバージョン報告はまだありません。手がかりがないことは App が最新であることを意味しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac보다 높은 커뮤니티 버전 보고가 아직 없습니다. 단서가 없다고 앱이 최신이라는 뜻은 아닙니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada laporan komuniti tentang versi yang lebih baharu daripada versi anda. Tiada petunjuk tidak bermakna apl sudah terkini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen rapporter fra fellesskapet om nyere versjoner enn din ennå. Ingen tips betyr ikke at appen er oppdatert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen meldingen uit de community over nieuwere versies dan de jouwe. Geen hints betekent niet dat de app bijgewerkt is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Społeczność nie zgłosiła jeszcze nowszych wersji niż Twoja. Brak wskazówek nie oznacza, że aplikacja jest aktualna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há relatos da comunidade de versões mais novas que a sua. Não ter pistas não significa que o app está atualizado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há relatos da comunidade de versões mais recentes do que a sua. Não haver pistas não significa que a app está atualizada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunitatea nu a raportat încă versiuni mai noi decât a dvs. Lipsa indiciilor nu înseamnă că aplicația este actualizată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщество пока не сообщало о версиях новее вашей. Отсутствие подсказок не означает, что приложение актуально."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Komunita zatiaľ nehlási novšie verzie než vaša. Absencia tipov neznamená, že aplikácia je aktuálna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga communityrapporter om nyare versioner än din ännu. Inga tips betyder inte att appen är uppdaterad."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรายงานจากชุมชนเกี่ยวกับเวอร์ชันที่ใหม่กว่าของคุณ การไม่มีเบาะแสไม่ได้หมายความว่าแอปเป็นเวอร์ชันล่าสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sizinkinden daha yeni sürümlere dair topluluk raporu yok. İpucu olmaması uygulamanın güncel olduğu anlamına gelmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спільнота поки не повідомляла про версії, новіші за вашу. Відсутність підказок не означає, що програма актуальна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có báo cáo cộng đồng về phiên bản mới hơn của bạn. Không có manh mối không có nghĩa là ứng dụng đã mới nhất."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有比本機更高的社群版本報告。沒有線索不代表 App 已是最新。"
          }
        }
      }
    },
    "暂未适配更新来源，可手动设置开发者 appcast 或 GitHub 仓库": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مصدر تحديث مدعوم بعد. يمكنك تعيين appcast المطوّر أو مستودع GitHub يدويًا"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha cap font d’actualització adaptada. Pots definir manualment l’appcast o el repositori de GitHub del desenvolupador"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není přizpůsoben žádný zdroj aktualizací. Appcast nebo repozitář GitHub vývojáře můžete nastavit ručně"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilpasset opdateringskilde endnu. Du kan angive udviklerens appcast eller GitHub-arkiv manuelt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Updatequelle angepasst. Du kannst den Appcast oder das GitHub-Repository des Entwicklers manuell festlegen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη προσαρμοσμένη πηγή ενημερώσεων. Μπορείτε να ορίσετε χειροκίνητα το appcast ή το αποθετήριο GitHub του προγραμματιστή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No update source is adapted yet. You can set the developer’s appcast or GitHub repository manually"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay una fuente de actualización adaptada. Puedes definir manualmente el appcast o el repositorio de GitHub del desarrollador"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivityslähdettä ei ole vielä sovitettu. Voit määrittää kehittäjän appcastin tai GitHub-tietovaraston käsin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune source de mise à jour adaptée pour l’instant. Vous pouvez définir manuellement l’appcast ou le dépôt GitHub du développeur"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין מקור עדכון מותאם. ניתן להגדיר ידנית את ה-appcast או את מאגר ה-GitHub של המפתח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई अनुकूलित अपडेट स्रोत नहीं है। आप डेवलपर का appcast या GitHub रिपॉज़िटरी मैन्युअल रूप से सेट कर सकते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nema prilagođenog izvora ažuriranja. Appcast ili GitHub repozitorij razvojnog programera možete postaviti ručno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs illesztett frissítési forrás. Manuálisan megadhatja a fejlesztő appcastját vagy GitHub-tárolóját"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sumber pembaruan yang didukung. Anda dapat mengatur appcast atau repositori GitHub pengembang secara manual"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna fonte di aggiornamento adattata. Puoi impostare manualmente l’appcast o il repository GitHub dello sviluppatore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するアップデートソースがまだありません。開発者の appcast または GitHub リポジトリを手動で設定できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 지원되는 업데이트 소스가 없습니다. 개발자 appcast 또는 GitHub 저장소를 수동으로 설정할 수 있습니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sumber kemas kini yang disokong. Anda boleh menetapkan appcast atau repositori GitHub pembangun secara manual"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilpasset oppdateringskilde ennå. Du kan angi utviklerens appcast eller GitHub-arkiv manuelt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen aangepaste updatebron. Je kunt de appcast of GitHub-repository van de ontwikkelaar handmatig instellen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostosowanego źródła uaktualnień. Możesz ręcznie ustawić appcast lub repozytorium GitHub dewelopera"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há fonte de atualização adaptada. Você pode definir manualmente o appcast ou o repositório GitHub do desenvolvedor"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem fonte de atualização adaptada. Pode definir manualmente o appcast ou o repositório GitHub do programador"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există o sursă de actualizare adaptată. Puteți seta manual appcast-ul sau depozitul GitHub al dezvoltatorului"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источник обновлений пока не адаптирован. Можно вручную указать appcast или репозиторий GitHub разработчика"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ nie je prispôsobený žiadny zdroj aktualizácií. Appcast alebo repozitár GitHub vývojára môžete nastaviť manuálne"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen anpassad uppdateringskälla ännu. Du kan ange utvecklarens appcast eller GitHub-förråd manuellt"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีแหล่งอัปเดตที่รองรับ คุณสามารถตั้งค่า appcast หรือคลัง GitHub ของผู้พัฒนาได้ด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz uyarlanmış güncelleme kaynağı yok. Geliştiricinin appcast’ini veya GitHub deposunu elle ayarlayabilirsiniz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерело оновлень поки не адаптовано. Можна вручну вказати appcast або репозиторій GitHub розробника"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có nguồn cập nhật được hỗ trợ. Bạn có thể đặt thủ công appcast hoặc kho GitHub của nhà phát triển"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未支援更新來源，可手動設定開發者 appcast 或 GitHub 儲存庫"
