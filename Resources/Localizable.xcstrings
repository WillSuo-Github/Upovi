    "网络连接未恢复，请联网后重新检测并下载。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد الاتصال بالشبكة. اتصل بالإنترنت مجددًا، ثم أعد الفحص ونزّل."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexió de xarxa no s’ha recuperat. Torna a connectar-te i després torna a comprovar i descarregar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síťové připojení nebylo obnoveno. Připojte se a poté znovu zkontrolujte a stáhněte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Netværksforbindelsen er ikke genoprettet. Gå online, og kontroller og hent derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Netzwerkverbindung ist nicht wiederhergestellt. Geh online und prüfe und lade dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση δικτύου δεν αποκαταστάθηκε. Συνδεθείτε και έπειτα ελέγξτε και κάντε λήψη ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network connection hasn’t recovered. Get back online, then recheck and download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de red no se ha recuperado. Conéctate y vuelve a comprobar y descargar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkkoyhteys ei ole palautunut. Muodosta yhteys ja tarkista ja lataa sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion réseau n’est pas rétablie. Reconnectez-vous, puis revérifiez et téléchargez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור לרשת לא חזר. התחבר שוב, ואז בדוק מחדש והורד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क कनेक्शन बहाल नहीं हुआ। फिर से ऑनलाइन हों, फिर दोबारा जाँचें और डाउनलोड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mrežna veza nije uspostavljena. Povežite se, a zatim ponovno provjerite i preuzmite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hálózati kapcsolat nem állt helyre. Csatlakozzon, majd ellenőrizzen és töltsön le újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi jaringan belum pulih. Kembali online, lalu periksa ulang dan unduh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione di rete non è stata ripristinata. Torna online, poi ricontrolla e scarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク接続が回復していません。接続後に再確認してダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결이 복구되지 않았습니다. 연결한 후 다시 확인하고 다운로드하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan rangkaian belum pulih. Kembali dalam talian, kemudian semak semula dan muat turun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettverkstilkoblingen er ikke gjenopprettet. Koble til, og kontroller og last deretter ned på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De netwerkverbinding is niet hersteld. Ga online en controleer en download daarna opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie sieciowe nie zostało przywrócone. Połącz się, a następnie sprawdź i pobierz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão de rede não voltou. Fique online e então verifique novamente e baixe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação de rede não foi restabelecida. Volte a estar online e depois verifique e transfira novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea la rețea nu a fost restabilită. Conectați-vă, apoi verificați și descărcați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевое подключение не восстановлено. Подключитесь к сети, затем проверьте и загрузите заново."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieťové pripojenie nebolo obnovené. Pripojte sa a potom znova skontrolujte a stiahnite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nätverksanslutningen har inte återställts. Gå online och kontrollera och hämta sedan igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อเครือข่ายยังไม่กลับมา โปรดเชื่อมต่ออีกครั้ง แล้วตรวจสอบใหม่และดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ bağlantısı geri gelmedi. Çevrimiçi olun, ardından yeniden denetleyip indirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережеве з’єднання не відновлено. Підключіться до мережі, потім перевірте й завантажте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối mạng chưa khôi phục. Hãy kết nối lại, rồi kiểm tra lại và tải về."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線未恢復，請連線後重新檢查並下載。"
          }
        }
      }
    },
    "自动寻找共享同一应用的公网节点，交换已签名的版本报告。社区报告只是线索，不计入可用更新，也不会用于安装。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر تلقائيًا على نظراء عامين يشاركون التطبيقات نفسها ويتبادل تقارير الإصدارات الموقّعة. تقارير المجتمع مجرد تلميحات؛ فهي لا تُحتسب تحديثات متاحة ولا تُستخدم أبدًا للتثبيت."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Troba automàticament nodes públics que comparteixen les mateixes apps i intercanvia informes de versions signats. Els informes de la comunitat només són pistes; no compten com a actualitzacions disponibles i mai no s’utilitzen per instal·lar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky vyhledá veřejné uzly sdílející stejné aplikace a vyměňuje si podepsané zprávy o verzích. Zprávy komunity jsou jen tipy; nepočítají se jako dostupné aktualizace a nikdy se nepoužívají k instalaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder automatisk offentlige knudepunkter, der deler de samme apps, og udveksler signerede versionsrapporter. Fællesskabsrapporter er kun tip; de tæller ikke som tilgængelige opdateringer og bruges aldrig til installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet automatisch öffentliche Knoten, die dieselben Apps teilen, und tauscht signierte Versionsberichte aus. Community-Berichte sind nur Hinweise; sie zählen nicht als verfügbare Updates und werden nie zur Installation verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρίσκει αυτόματα δημόσιους κόμβους που μοιράζονται τις ίδιες εφαρμογές και ανταλλάσσει υπογεγραμμένες αναφορές εκδόσεων. Οι αναφορές της κοινότητας είναι μόνο ενδείξεις· δεν μετρούν ως διαθέσιμες ενημερώσεις και δεν χρησιμοποιούνται ποτέ για εγκατάσταση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically finds public peers sharing the same apps and exchanges signed version reports. Community reports are only leads; they don’t count as available updates and are never used for installing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra automáticamente nodos públicos que comparten las mismas apps e intercambia informes de versión firmados. Los informes de la comunidad son solo indicios; no cuentan como actualizaciones disponibles y nunca se usan para instalar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etsii automaattisesti julkisia solmuja, jotka jakavat samoja appeja, ja vaihtaa allekirjoitettuja versioraportteja. Yhteisön raportit ovat vain vihjeitä; niitä ei lasketa saatavilla oleviksi päivityksiksi eikä niitä koskaan käytetä asennukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouve automatiquement les nœuds publics partageant les mêmes apps et échange des rapports de version signés. Les rapports de la communauté ne sont que des indices ; ils ne comptent pas comme mises à jour disponibles et ne servent jamais à l’installation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצא אוטומטית עמיתים ציבוריים המשתפים את אותם יישומים ומחליף דוחות גרסה חתומים. דיווחי קהילה הם רמזים בלבד; הם אינם נספרים כעדכונים זמינים ולעולם אינם משמשים להתקנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समान ऐप साझा करने वाले सार्वजनिक पीयर अपने-आप ढूँढता है और हस्ताक्षरित संस्करण रिपोर्ट का आदान-प्रदान करता है। समुदाय रिपोर्ट केवल संकेत हैं; इन्हें उपलब्ध अपडेट नहीं गिना जाता और इंस्टॉल करने के लिए कभी उपयोग नहीं किया जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski pronalazi javne čvorove koji dijele iste aplikacije i razmjenjuje potpisana izvješća o verzijama. Izvješća zajednice samo su savjeti; ne broje se kao dostupna ažuriranja i nikad se ne koriste za instalaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan megkeresi az ugyanazokat az alkalmazásokat megosztó nyilvános csomópontokat, és aláírt verziójelentéseket cserél. A közösségi jelentések csak tippek; nem számítanak elérhető frissítésnek, és soha nem használja őket telepítésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara otomatis menemukan peer publik yang berbagi app yang sama dan bertukar laporan versi bertanda tangan. Laporan komunitas hanya petunjuk; laporan ini tidak dihitung sebagai pembaruan tersedia dan tidak pernah digunakan untuk instalasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova automaticamente nodi pubblici che condividono le stesse app e scambia rapporti di versione firmati. I rapporti della community sono solo indizi; non contano come aggiornamenti disponibili e non vengono mai usati per installare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ App を共有する公開ノードを自動で探し、署名済みのバージョン報告を交換します。コミュニティの報告は手がかりにすぎず、利用可能なアップデートに含まれず、インストールにも使用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 앱을 공유하는 공개 노드를 자동으로 찾아 서명된 버전 보고서를 교환합니다. 커뮤니티 보고는 단서일 뿐이며 사용 가능한 업데이트에 포함되지 않고 설치에도 사용되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari rakan awam yang berkongsi apl yang sama secara automatik dan bertukar laporan versi bertandatangan. Laporan komuniti hanyalah petunjuk; ia tidak dikira sebagai kemas kini tersedia dan tidak pernah digunakan untuk pemasangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Finner automatisk offentlige noder som deler de samme appene, og utveksler signerte versjonsrapporter. Fellesskapsrapporter er bare tips; de telles ikke som tilgjengelige oppdateringer og brukes aldri til installering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoekt automatisch openbare knooppunten die dezelfde apps delen en wisselt ondertekende versierapporten uit. Communityrapporten zijn alleen hints; ze tellen niet als beschikbare updates en worden nooit gebruikt om te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie znajduje węzły publiczne udostępniające te same aplikacje i wymienia podpisane raporty o wersjach. Raporty społeczności są tylko wskazówkami; nie są liczone jako dostępne uaktualnienia i nigdy nie służą do instalacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra automaticamente nós públicos que compartilham os mesmos apps e troca relatórios de versão assinados. Relatos da comunidade são apenas pistas; não contam como atualizações disponíveis e nunca são usados para instalar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra automaticamente nós públicos que partilham as mesmas apps e troca relatórios de versão assinados. Os relatos da comunidade são apenas pistas; não contam como atualizações disponíveis e nunca são usados para instalar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Găsește automat noduri publice care partajează aceleași aplicații și schimbă rapoarte de versiune semnate. Rapoartele comunității sunt doar indicii; nu sunt considerate actualizări disponibile și nu sunt folosite niciodată la instalare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически находит публичные узлы, которые делятся теми же приложениями, и обменивается подписанными отчётами о версиях. Отчёты сообщества — лишь подсказки; они не считаются доступными обновлениями и никогда не используются для установки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky vyhľadá verejné uzly zdieľajúce rovnaké aplikácie a vymieňa si podpísané správy o verziách. Správy komunity sú len tipy; nepočítajú sa ako dostupné aktualizácie a nikdy sa nepoužívajú na inštaláciu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittar automatiskt offentliga noder som delar samma appar och utbyter signerade versionsrapporter. Communityrapporter är bara tips; de räknas inte som tillgängliga uppdateringar och används aldrig för installation."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาโหนดสาธารณะที่แชร์แอปเดียวกันโดยอัตโนมัติและแลกเปลี่ยนรายงานเวอร์ชันที่ลงนามแล้ว รายงานชุมชนเป็นเพียงเบาะแส ไม่นับเป็นอัปเดตที่มีและไม่ถูกใช้สำหรับการติดตั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı uygulamaları paylaşan genel eşleri otomatik bulur ve imzalı sürüm raporları alışverişi yapar. Topluluk raporları yalnızca ipucudur; mevcut güncelleme sayılmaz ve asla yükleme için kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично знаходить публічні вузли, що діляться тими самими програмами, і обмінюється підписаними звітами про версії. Звіти спільноти — лише підказки; вони не вважаються доступними оновленнями й ніколи не використовуються для інсталяції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động tìm các nút công khai chia sẻ cùng ứng dụng và trao đổi báo cáo phiên bản có chữ ký. Báo cáo cộng đồng chỉ là manh mối; chúng không được tính là bản cập nhật khả dụng và không bao giờ được dùng để cài đặt."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動尋找分享同一 App 的公網節點，交換已簽章的版本報告。社群報告只是線索，不計入可用更新，也不會用於安裝。"
          }
        }
      }
    },
