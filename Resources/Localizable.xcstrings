    "安装未完成或授权已取消；恢复时会核对系统备份": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التثبيت غير مكتمل أو أُلغي التفويض؛ يتم فحص النسخ الاحتياطية للنظام عند الاستعادة"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal·lació incompleta o autorització cancel·lada; es comproven les còpies del sistema en restaurar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalace nedokončena nebo autorizace zrušena; při obnovení se kontrolují systémové zálohy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation ikke fuldført eller godkendelse annulleret; systemsikkerhedskopier kontrolleres ved gendannelse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation unvollständig oder Autorisierung abgebrochen; beim Wiederherstellen werden System-Backups geprüft"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μη ολοκληρωμένη εγκατάσταση ή ακυρωμένη εξουσιοδότηση· τα εφεδρικά αντίγραφα συστήματος ελέγχονται κατά την επαναφορά"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation incomplete or authorization cancelled; system backups are checked when restoring"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalación incompleta o autorización cancelada; las copias del sistema se comprueban al restaurar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asennus kesken tai valtuutus peruttu; järjestelmän varmuuskopiot tarkistetaan palautettaessa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation inachevée ou autorisation annulée ; les sauvegardes système sont vérifiées lors de la restauration"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתקנה לא הושלמה או שההרשאה בוטלה; גיבויי המערכת נבדקים בעת השחזור"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉलेशन अधूरा या प्राधिकरण रद्द; पुनर्स्थापना के समय सिस्टम बैकअप जाँचे जाते हैं"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacija nije dovršena ili je autorizacija otkazana; pri vraćanju provjeravaju se sistemske sigurnosne kopije"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepítés befejezetlen, vagy az engedélyezés megszakadt; visszaállításkor ellenőrzi a rendszer-biztonsági másolatokat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalasi belum selesai atau otorisasi dibatalkan; cadangan sistem diperiksa saat memulihkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installazione incompleta o autorizzazione annullata; i backup di sistema vengono verificati al ripristino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールが未完了か、認証がキャンセルされました。復元時にシステムバックアップを確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치가 완료되지 않았거나 인증이 취소됨. 복원 시 시스템 백업을 확인함"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasangan tidak lengkap atau kebenaran dibatalkan; sandaran sistem disemak semasa memulihkan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installering ikke fullført eller autorisasjon avbrutt; systemsikkerhetskopier kontrolleres ved gjenoppretting"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installatie onvoltooid of autorisatie geannuleerd; bij herstel worden systeemreservekopieën gecontroleerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja nieukończona lub autoryzacja anulowana; podczas odtwarzania sprawdzane są kopie systemowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalação incompleta ou autorização cancelada; backups do sistema são verificados ao restaurar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalação incompleta ou autorização cancelada; as cópias de segurança do sistema são verificadas ao restaurar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalare neterminată sau autorizare anulată; la restaurare se verifică copiile de rezervă de sistem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка не завершена или авторизация отменена; при восстановлении проверяются системные резервные копии"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inštalácia nedokončená alebo autorizácia zrušená; pri obnovení sa kontrolujú systémové zálohy"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationen ej slutförd eller auktoriseringen avbruten; systemsäkerhetskopior kontrolleras vid återställning"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การติดตั้งไม่เสร็จสมบูรณ์หรือการอนุญาตถูกยกเลิก จะตรวจสอบข้อมูลสำรองของระบบเมื่อกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme tamamlanmadı veya yetkilendirme iptal edildi; geri yüklerken sistem yedekleri denetlenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інсталяцію не завершено або авторизацію скасовано; під час відновлення перевіряються системні резервні копії"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt chưa hoàn tất hoặc đã hủy ủy quyền; bản sao lưu hệ thống sẽ được kiểm tra khi khôi phục"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝未完成或授權已取消；還原時會核對系統備份"
          }
        }
      }
    },
