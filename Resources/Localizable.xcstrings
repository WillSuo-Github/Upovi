          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установщик проверен, ожидание подтверждения установки администратором"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inštalátor overený, čaká sa na potvrdenie inštalácie správcom"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogrammet verifierat, väntar på bekräftelse av administratörsinstallation"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบตัวติดตั้งแล้ว กำลังรอผู้ดูแลระบบยืนยันการติดตั้ง"
          }
        },
        "tr": {
