          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaden of integriteitscontrole mislukt. Controleer de bron opnieuw of gebruik de officiële update."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
