          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte aplikáciu v zozname a zobrazte jej verzie, zdroje a akcie aktualizácie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera en app i listan för att se versioner, källor och uppdateringsåtgärder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแอปในรายการเพื่อดูเวอร์ชัน แหล่ง และการดำเนินการอัปเดต"
