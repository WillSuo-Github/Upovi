          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi сканує /Applications і ~/Applications, а потім звіряє версії з Sparkle, Homebrew, GitHub і App Store."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi quét /Applications và ~/Applications, rồi đối chiếu phiên bản với Sparkle, Homebrew, GitHub và App Store."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi 會掃描 /Applications 與 ~/Applications，再向 Sparkle、Homebrew、GitHub 與 App Store 來源核對版本。"
          }
        }
      }
    },
    "Upovi 安装更新时会保留旧版本，可在这里恢复或清理保留副本。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ Upovi بالإصدار السابق عند تثبيت تحديث. يمكنك استعادة النسخ المحتفظ بها أو تنظيفها من هنا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi conserva la versió anterior en instal·lar una actualització. Restaura o neteja aquí les còpies conservades."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při instalaci aktualizace Upovi uchovává předchozí verzi. Zde ji můžete obnovit nebo odstranit uchované kopie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi beholder den tidligere version, når en opdatering installeres. Gendan eller ryd gemte kopier her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi behält bei der Installation eines Updates die vorherige Version. Hier kannst du sie wiederherstellen oder aufbewahrte Kopien entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Upovi διατηρεί την προηγούμενη έκδοση κατά την εγκατάσταση ενημέρωσης. Επαναφέρετε ή εκκαθαρίστε εδώ τα αντίγραφα που διατηρούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi keeps the previous version when installing an update. Restore or clean up retained copies here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi conserva la versión anterior al instalar una actualización. Restaura o elimina aquí las copias conservadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi säilyttää edellisen version päivitystä asennettaessa. Palauta tai poista säilytetyt kopiot täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi conserve la version précédente lors de l’installation d’une mise à jour. Restaurez ou supprimez ici les copies conservées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi שומר את הגרסה הקודמת בעת התקנת עדכון. כאן אפשר לשחזר או לנקות עותקים שנשמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपडेट इंस्टॉल करते समय Upovi पिछला संस्करण रखता है। रखी गई प्रतियों को यहाँ पुनर्स्थापित करें या साफ़ करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi pri instalaciji ažuriranja čuva prethodnu verziju. Ovdje je možete vratiti ili očistiti sačuvane kopije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Upovi frissítés telepítésekor megőrzi az előző verziót. Itt visszaállíthatja, vagy törölheti a megőrzött másolatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi menyimpan versi sebelumnya saat menginstal pembaruan. Pulihkan atau bersihkan salinan yang disimpan di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi conserva la versione precedente durante l’installazione di un aggiornamento. Qui puoi ripristinarla o rimuovere le copie conservate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi はアップデートのインストール時に旧バージョンを保持します。ここで復元したり、保持したコピーを削除したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi는 업데이트 설치 시 이전 버전을 보관합니다. 여기에서 복원하거나 보관된 사본을 정리할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi menyimpan versi sebelumnya semasa memasang kemas kini. Pulihkan atau bersihkan salinan yang disimpan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi beholder den forrige versjonen når en oppdatering installeres. Gjenopprett eller fjern lagrede kopier her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi bewaart de vorige versie bij het installeren van een update. Herstel of verwijder hier bewaarde kopieën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi zachowuje poprzednią wersję podczas instalowania uaktualnienia. Tutaj możesz ją odtworzyć lub usunąć zachowane kopie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Upovi mantém a versão anterior ao instalar uma atualização. Restaure ou remova aqui as cópias mantidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Upovi mantém a versão anterior ao instalar uma atualização. Restaure ou remova aqui as cópias mantidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi păstrează versiunea anterioară la instalarea unei actualizări. Restaurați sau curățați aici copiile păstrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При установке обновления Upovi сохраняет предыдущую версию. Здесь её можно восстановить или удалить сохранённые копии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri inštalácii aktualizácie Upovi uchováva predchádzajúcu verziu. Tu ju môžete obnoviť alebo odstrániť uchované kópie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi behåller den tidigare versionen när en uppdatering installeras. Återställ eller rensa sparade kopior här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi เก็บเวอร์ชันก่อนหน้าไว้เมื่อติดตั้งอัปเดต กู้คืนหรือล้างสำเนาที่เก็บไว้ได้ที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi bir güncellemeyi yüklerken önceki sürümü saklar. Saklanan kopyaları buradan geri yükleyin veya temizleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час інсталяції оновлення Upovi зберігає попередню версію. Тут її можна відновити або видалити збережені копії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi giữ lại phiên bản trước khi cài đặt bản cập nhật. Khôi phục hoặc dọn dẹp các bản sao đã giữ tại đây."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Upovi 安裝更新時會保留舊版本，可在這裡還原或清理保留副本。"
          }
        }
      }
    },
