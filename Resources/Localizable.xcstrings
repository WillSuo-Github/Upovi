          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne appen vises ikke i Oppdateringer, «Oppdater alle» eller varsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app verschijnt niet in Updates, 'Werk alles bij' of in meldingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja nie pojawi się w Uaktualnieniach, „Uaktualnij wszystko” ani w powiadomieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
