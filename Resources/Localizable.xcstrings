            "value": "แจกจ่ายโดยผู้พัฒนา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici Dağıtımı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поширюється розробником"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân phối bởi nhà phát triển"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發者發佈"
          }
        }
      }
    },
    "开启后，Upovi 会通过 BitTorrent DHT 与其他用户交换已扫描应用的版本信息，帮助更早发现新版本。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل، يتبادل Upovi معلومات إصدارات التطبيقات المفحوصة مع مستخدمين آخرين عبر BitTorrent DHT لاكتشاف الإصدارات الجديدة أسرع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan està activat, Upovi intercanvia informació de versions de les apps escanejades amb altres usuaris mitjançant BitTorrent DHT per descobrir versions noves abans."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je-li zapnuto, Upovi si přes BitTorrent DHT vyměňuje s ostatními uživateli informace o verzích prohledaných aplikací, aby dříve našel nové verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er slået til, udveksler Upovi versionsoplysninger om scannede apps med andre brugere via BitTorrent DHT for at finde nye versioner tidligere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, tauscht Upovi über BitTorrent DHT Versionsinformationen gescannter Apps mit anderen Benutzern aus, um neue Versionen früher zu entdecken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ενεργό, το Upovi ανταλλάσσει πληροφορίες εκδόσεων των σαρωμένων εφαρμογών με άλλους χρήστες μέσω BitTorrent DHT, ώστε να βρίσκει νωρίτερα νέες εκδόσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, Upovi exchanges version information about scanned apps with other users over BitTorrent DHT to discover new versions sooner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se activa, Upovi intercambia información de versiones de las apps analizadas con otros usuarios mediante BitTorrent DHT para descubrir antes las nuevas versiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun asetus on päällä, Upovi vaihtaa skannattujen appien versiotietoja muiden käyttäjien kanssa BitTorrent DHT:n kautta löytääkseen uudet versiot aiemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, Upovi échange les informations de version des apps analysées avec d’autres utilisateurs via BitTorrent DHT pour découvrir plus tôt les nouvelles versions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהאפשרות פועלת, Upovi מחליף מידע על גרסאות היישומים שנסרקו עם משתמשים אחרים דרך BitTorrent DHT כדי לגלות גרסאות חדשות מוקדם יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर Upovi नए संस्करण जल्दी खोजने के लिए BitTorrent DHT के ज़रिए स्कैन किए गए ऐप की संस्करण जानकारी अन्य उपयोगकर्ताओं के साथ साझा करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključeno, Upovi putem BitTorrent DHT-a razmjenjuje podatke o verzijama skeniranih aplikacija s drugim korisnicima kako bi ranije otkrio nove verzije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolva az Upovi a BitTorrent DHT-n keresztül cseréli a beolvasott alkalmazások verzióadatait más felhasználókkal, hogy hamarabb megtalálja az új verziókat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat aktif, Upovi bertukar informasi versi app yang dipindai dengan pengguna lain melalui BitTorrent DHT untuk menemukan versi baru lebih awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, Upovi scambia con altri utenti tramite BitTorrent DHT le informazioni sulle versioni delle app analizzate per scoprire prima le nuove versioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、Upovi は BitTorrent DHT を通じてほかのユーザとスキャンした App のバージョン情報を交換し、新しいバージョンをより早く見つけられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 Upovi가 BitTorrent DHT를 통해 다른 사용자와 스캔한 앱의 버전 정보를 교환하여 새 버전을 더 빨리 발견할 수 있도록 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila dihidupkan, Upovi bertukar maklumat versi apl yang diimbas dengan pengguna lain melalui BitTorrent DHT untuk menemui versi baharu lebih awal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er på, utveksler Upovi versjonsinformasjon om skannede apper med andre brukere via BitTorrent DHT for å finne nye versjoner tidligere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld wisselt Upovi via BitTorrent DHT versie-informatie van gescande apps uit met andere gebruikers, zodat nieuwe versies eerder worden ontdekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu Upovi wymienia informacje o wersjach przeskanowanych aplikacji z innymi użytkownikami przez BitTorrent DHT, aby szybciej znajdować nowe wersje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Upovi troca informações de versão dos apps analisados com outros usuários via BitTorrent DHT para descobrir novas versões mais cedo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Upovi troca informações de versão das apps analisadas com outros utilizadores através do BitTorrent DHT para descobrir novas versões mais cedo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este activat, Upovi schimbă informații despre versiunile aplicațiilor scanate cu alți utilizatori prin BitTorrent DHT pentru a descoperi mai devreme versiunile noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, Upovi обменивается сведениями о версиях просканированных приложений с другими пользователями через BitTorrent DHT, чтобы раньше находить новые версии."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je zapnuté, Upovi si cez BitTorrent DHT vymieňa s ostatnými používateľmi informácie o verziách prehľadaných aplikácií, aby skôr našiel nové verzie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När detta är aktiverat utbyter Upovi versionsinformation om skannade appar med andra användare via BitTorrent DHT för att hitta nya versioner tidigare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้ Upovi จะแลกเปลี่ยนข้อมูลเวอร์ชันของแอปที่สแกนกับผู้ใช้อื่นผ่าน BitTorrent DHT เพื่อค้นพบเวอร์ชันใหม่ได้เร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken Upovi, yeni sürümleri daha erken keşfetmek için taranan uygulamaların sürüm bilgilerini BitTorrent DHT üzerinden diğer kullanıcılarla paylaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо увімкнено, Upovi обмінюється відомостями про версії просканованих програм з іншими користувачами через BitTorrent DHT, щоб раніше знаходити нові версії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, Upovi trao đổi thông tin phiên bản của các ứng dụng đã quét với người dùng khác qua BitTorrent DHT để phát hiện phiên bản mới sớm hơn."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，Upovi 會透過 BitTorrent DHT 與其他使用者交換已掃描 App 的版本資訊，協助更早發現新版本。"
          }
        }
      }
    },
