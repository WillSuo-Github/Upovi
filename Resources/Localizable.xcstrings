    "无法确认已安装应用的开发者，请使用官方更新": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر تأكيد مطوّر التطبيق المثبّت؛ استخدم أداة التحديث الرسمية"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot confirmar el desenvolupador de l’app instal·lada; utilitza l’actualitzador oficial"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vývojáře nainstalované aplikace nelze potvrdit; použijte oficiální aktualizaci"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udvikleren af den installerede app kan ikke bekræftes; brug den officielle opdatering"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwickler der installierten App lässt sich nicht bestätigen; verwende die offizielle Aktualisierung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η επιβεβαίωση του προγραμματιστή της εγκατεστημένης εφαρμογής· χρησιμοποιήστε την επίσημη ενημέρωση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t confirm the installed app’s developer; use the official updater"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede confirmar el desarrollador de la app instalada; usa la actualización oficial"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asennetun apin kehittäjää ei voi vahvistaa; käytä virallista päivitystä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer le développeur de l’app installée ; utilisez la mise à jour officielle"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאשר את המפתח של היישום המותקן; השתמש במעדכן הרשמי"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल किए गए ऐप के डेवलपर की पुष्टि नहीं हो सकती; आधिकारिक अपडेटर का उपयोग करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Razvojni programer instalirane aplikacije ne može se potvrditi; upotrijebite službeno ažuriranje"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepített alkalmazás fejlesztője nem erősíthető meg; használja a hivatalos frissítést"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengonfirmasi pengembang app yang terinstal; gunakan pembaru resmi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare lo sviluppatore dell’app installata; usa l’aggiornamento ufficiale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み App の開発者を確認できません。公式のアップデートを使用してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱의 개발자를 확인할 수 없습니다. 공식 업데이트를 사용하십시오"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengesahkan pembangun apl yang dipasang; gunakan pengemas kini rasmi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvikleren av den installerte appen kan ikke bekreftes; bruk den offisielle oppdateringen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ontwikkelaar van de geïnstalleerde app kan niet worden bevestigd; gebruik de officiële update"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można potwierdzić dewelopera zainstalowanej aplikacji; użyj oficjalnego uaktualnienia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível confirmar o desenvolvedor do app instalado; use a atualização oficial"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível confirmar o programador da app instalada; utilize a atualização oficial"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezvoltatorul aplicației instalate nu poate fi confirmat; folosiți actualizarea oficială"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся подтвердить разработчика установленного приложения; используйте официальное обновление"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vývojára nainštalovanej aplikácie nemožno potvrdiť; použite oficiálnu aktualizáciu"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvecklaren av den installerade appen kan inte bekräftas; använd den officiella uppdateringen"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถยืนยันผู้พัฒนาของแอปที่ติดตั้งไว้ โปรดใช้ตัวอัปเดตทางการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü uygulamanın geliştiricisi doğrulanamıyor; resmi güncelleyiciyi kullanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається підтвердити розробника встановленої програми; використовуйте офіційне оновлення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận nhà phát triển của ứng dụng đã cài; hãy dùng trình cập nhật chính thức"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認已安裝 App 的開發者，請使用官方更新"
          }
        }
      }
    },
    "无法验证时，引导到官方来源更新。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تعذّر التحقق من المثبّت، يتم توجيهك إلى المصدر الرسمي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan no es pot verificar un instal·lador, se t’adreça a la font oficial."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud instalátor nelze ověřit, budete přesměrováni na oficiální zdroj."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis et installationsprogram ikke kan kontrolleres, henvises du til den officielle kilde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn sich ein Installationsprogramm nicht prüfen lässt, wirst du zur offiziellen Quelle geleitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν ένα πρόγραμμα εγκατάστασης δεν μπορεί να επαληθευτεί, κατευθύνεστε στην επίσημη πηγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an installer can’t be verified, you’re directed to the official source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un instalador no puede verificarse, te dirige a la fuente oficial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos asentajaa ei voi tarkistaa, sinut ohjataan viralliseen lähteeseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un programme d’installation ne peut pas être vérifié, vous êtes redirigé vers la source officielle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשלא ניתן לאמת מתקין, תופנה למקור הרשמי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब इंस्टॉलर सत्यापित नहीं हो पाता, तो आपको आधिकारिक स्रोत पर भेजा जाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako se instalacijski program ne može provjeriti, upućujemo vas na službeni izvor."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha egy telepítő nem ellenőrizhető, a hivatalos forráshoz irányítjuk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika penginstal tidak dapat diverifikasi, Anda akan diarahkan ke sumber resmi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un programma di installazione non può essere verificato, vieni indirizzato alla fonte ufficiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証できない場合は、公式ソースでのアップデートを案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 수 없는 경우 공식 소스로 안내합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika pemasang tidak dapat disahkan, anda akan diarahkan ke sumber rasmi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis et installeringsprogram ikke kan kontrolleres, henvises du til den offisielle kilden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als een installatieprogramma niet kan worden gecontroleerd, word je naar de officiële bron verwezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy instalatora nie można zweryfikować, nastąpi przekierowanie do oficjalnego źródła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um instalador não pode ser verificado, você é levado à fonte oficial."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um instalador não pode ser verificado, é encaminhado para a fonte oficial."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când un program de instalare nu poate fi verificat, sunteți îndrumat către sursa oficială."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если установщик нельзя проверить, вы будете направлены к официальному источнику."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak inštalátor nemožno overiť, budete presmerovaní na oficiálny zdroj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om ett installationsprogram inte kan verifieras hänvisas du till den officiella källan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อตรวจสอบตัวติดตั้งไม่ได้ คุณจะถูกนำไปยังแหล่งทางการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yükleyici doğrulanamadığında resmi kaynağa yönlendirilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо інсталятор неможливо перевірити, вас буде спрямовано до офіційного джерела."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi không thể xác minh trình cài đặt, bạn sẽ được hướng đến nguồn chính thức."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證時，引導到官方來源更新。"
          }
        }
      }
    },
    "旧版官方文件与资源签名已核对，将升级为开发者签名版本。首次打开时可能需要重新确认系统权限。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحقق من الملفات الرسمية القديمة وتوقيعات الموارد؛ ستتم ترقية التطبيق إلى الإصدار الموقّع من المطوّر. قد تحتاج إلى تأكيد أذونات النظام مجددًا عند الفتح لأول مرة."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’han verificat els fitxers oficials antics i les signatures dels recursos; l’app s’actualitzarà a la versió signada pel desenvolupador. Pot ser que hagis de tornar a confirmar els permisos del sistema en el primer inici."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Staré oficiální soubory a podpisy prostředků byly ověřeny; aplikace bude aktualizována na verzi podepsanou vývojářem. Při prvním spuštění může být nutné znovu potvrdit systémová oprávnění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De gamle officielle filer og ressourcesignaturer er kontrolleret; appen opgraderes til den udviklersignerede version. Du skal muligvis bekræfte systemtilladelser igen ved første start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte offizielle Dateien und Ressourcensignaturen wurden geprüft; die App wird auf die entwicklersignierte Version aktualisiert. Beim ersten Öffnen musst du Systemberechtigungen eventuell erneut bestätigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα παλιά επίσημα αρχεία και οι υπογραφές πόρων επαληθεύτηκαν· η εφαρμογή θα αναβαθμιστεί στην έκδοση με υπογραφή προγραμματιστή. Ίσως χρειαστεί να επιβεβαιώσετε ξανά τα δικαιώματα συστήματος στην πρώτη εκκίνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old official files and resource signatures were verified; the app will be upgraded to the developer-signed version. You may need to confirm system permissions again on first launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se verificaron los archivos oficiales antiguos y las firmas de recursos; la app se actualizará a la versión firmada por el desarrollador. Puede que tengas que volver a confirmar los permisos del sistema al abrirla por primera vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhat viralliset tiedostot ja resurssien allekirjoitukset tarkistettiin; appi päivitetään kehittäjän allekirjoittamaan versioon. Järjestelmäoikeudet on ehkä vahvistettava uudelleen ensimmäisellä käynnistyskerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens fichiers officiels et signatures de ressources ont été vérifiés ; l’app passera à la version signée par le développeur. Il faudra peut-être reconfirmer les autorisations système au premier lancement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים הרשמיים הישנים וחתימות המשאבים אומתו; היישום ישודרג לגרסה החתומה על ידי המפתח. ייתכן שתצטרך לאשר שוב הרשאות מערכת בפתיחה הראשונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरानी आधिकारिक फ़ाइलें और संसाधन हस्ताक्षर सत्यापित हुए; ऐप को डेवलपर-हस्ताक्षरित संस्करण में अपग्रेड किया जाएगा। पहली बार खोलने पर आपको सिस्टम अनुमतियाँ फिर से पुष्टि करनी पड़ सकती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stare službene datoteke i potpisi resursa provjereni su; aplikacija će se nadograditi na verziju koju je potpisao razvojni programer. Pri prvom pokretanju možda ćete morati ponovno potvrditi sistemske dozvole."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A régi hivatalos fájlok és erőforrás-aláírások ellenőrizve; az alkalmazás a fejlesztő által aláírt verzióra frissül. Első indításkor lehet, hogy újra meg kell erősítenie a rendszerengedélyeket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File resmi lama dan tanda tangan sumber daya telah diverifikasi; app akan ditingkatkan ke versi bertanda tangan pengembang. Anda mungkin perlu mengonfirmasi ulang izin sistem saat pertama kali dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I vecchi file ufficiali e le firme delle risorse sono stati verificati; l’app verrà aggiornata alla versione firmata dallo sviluppatore. Al primo avvio potrebbe essere necessario confermare di nuovo i permessi di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版の公式ファイルとリソースの署名を確認しました。開発者署名版にアップグレードします。初回起動時にシステムの許可を再確認する必要がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 공식 파일 및 리소스 서명을 확인했으며 개발자 서명 버전으로 업그레이드됩니다. 처음 열 때 시스템 권한을 다시 확인해야 할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fail rasmi lama dan tandatangan sumber telah disahkan; apl akan dinaik taraf kepada versi bertandatangan pembangun. Anda mungkin perlu mengesahkan semula kebenaran sistem semasa pembukaan pertama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De gamle offisielle filene og ressurssignaturene er kontrollert; appen oppgraderes til den utviklersignerte versjonen. Du må kanskje bekrefte systemtillatelser på nytt ved første oppstart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De oude officiële bestanden en resourcehandtekeningen zijn gecontroleerd; de app wordt bijgewerkt naar de door de ontwikkelaar ondertekende versie. Bij de eerste start moet je systeemrechten mogelijk opnieuw bevestigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzono stare oficjalne pliki i podpisy zasobów; aplikacja zostanie uaktualniona do wersji podpisanej przez dewelopera. Przy pierwszym otwarciu może być konieczne ponowne potwierdzenie uprawnień systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos oficiais antigos e as assinaturas de recursos foram verificados; o app será atualizado para a versão assinada pelo desenvolvedor. Talvez seja preciso confirmar de novo as permissões do sistema ao abrir pela primeira vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros oficiais antigos e as assinaturas de recursos foram verificados; a app será atualizada para a versão assinada pelo programador. Poderá ser necessário confirmar novamente as permissões do sistema na primeira abertura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fișierele oficiale vechi și semnăturile resurselor au fost verificate; aplicația va fi actualizată la versiunea semnată de dezvoltator. Este posibil să trebuiască să reconfirmați permisiunile de sistem la prima pornire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые официальные файлы и подписи ресурсов проверены; приложение будет обновлено до версии с подписью разработчика. При первом запуске может потребоваться заново подтвердить системные разрешения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Staré oficiálne súbory a podpisy prostriedkov boli overené; aplikácia sa aktualizuje na verziu podpísanú vývojárom. Pri prvom spustení môže byť potrebné znova potvrdiť systémové povolenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De gamla officiella filerna och resurssignaturerna har kontrollerats; appen uppgraderas till den utvecklarsignerade versionen. Du kan behöva bekräfta systembehörigheter igen vid första start."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบไฟล์ทางการเก่าและลายเซ็นทรัพยากรแล้ว แอปจะถูกอัปเกรดเป็นเวอร์ชันที่ผู้พัฒนาลงนาม คุณอาจต้องยืนยันสิทธิ์ของระบบอีกครั้งเมื่อเปิดครั้งแรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski resmi dosyalar ve kaynak imzaları doğrulandı; uygulama geliştirici imzalı sürüme yükseltilecek. İlk açılışta sistem izinlerini yeniden onaylamanız gerekebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старі офіційні файли й підписи ресурсів перевірено; програму буде оновлено до версії з підписом розробника. Під час першого запуску може знадобитися знову підтвердити системні дозволи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp chính thức cũ và chữ ký tài nguyên đã được xác minh; ứng dụng sẽ được nâng cấp lên phiên bản có chữ ký nhà phát triển. Bạn có thể cần xác nhận lại quyền hệ thống ở lần mở đầu tiên."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版官方檔案與資源簽章已核對，將升級為開發者簽章版本。首次打開時可能需要重新確認系統權限。"
          }
        }
      }
    },
    "旧版本备份已移到废纸篓": {
      "localizations": {
