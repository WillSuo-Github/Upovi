    "安装包已验证，等待管理员安装确认": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحقق من المثبّت، بانتظار تأكيد المسؤول للتثبيت"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal·lador verificat, a l’espera de la confirmació d’instal·lació de l’administrador"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalátor ověřen, čeká se na potvrzení instalace správcem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogram bekræftet, venter på bekræftelse af administratorinstallation"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsprogramm geprüft, warte auf Bestätigung der Administratorinstallation"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το πρόγραμμα εγκατάστασης επαληθεύτηκε, αναμονή επιβεβαίωσης εγκατάστασης διαχειριστή"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer verified, waiting for administrator install confirmation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalador verificado, esperando la confirmación de instalación de administrador"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asentaja tarkistettu, odotetaan pääkäyttäjän asennuksen vahvistusta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme d’installation vérifié, en attente de confirmation de l’installation administrateur"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתקין אומת, ממתין לאישור התקנה של המנהל"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉलर सत्यापित, व्यवस्थापक इंस्टॉल पुष्टि की प्रतीक्षा है"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacijski program provjeren, čeka se potvrda instalacije administratora"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telepítő ellenőrizve, rendszergazdai telepítés megerősítésére vár"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penginstal terverifikasi, menunggu konfirmasi instalasi administrator"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Programma di installazione verificato, in attesa della conferma dell’installazione amministratore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストーラを検証しました。管理者によるインストールの確認を待っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 프로그램 확인됨. 관리자 설치 확인 대기 중"
          }
        },
        "ms": {
